---
import { initialEngineData } from '../data/engineTelemetry';

const { metrics } = initialEngineData;
---

<section class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-3 mb-4" aria-label="Engine Telemetry Metrics">
  
  <!-- 1. ENGINE HEALTH -->
  <div class="relative overflow-hidden rounded-lg bg-[#0d1322] border border-slate-800 p-3.5 flex flex-col justify-between hover:border-cyan-500/40 transition-all duration-300 group shadow-sm">
    <div class="flex items-center justify-between gap-1 text-[11px] font-mono-tech text-slate-400">
      <span class="tracking-wide">ENGINE HEALTH</span>
      <span id="metric-health-status" class="px-1.5 py-0.2 rounded text-[10px] font-bold bg-emerald-950/60 text-emerald-400 border border-emerald-500/30">
        {metrics.healthStatus}
      </span>
    </div>
    
    <div class="my-2 flex items-baseline gap-1.5">
      <span id="metric-health-val" class="text-2xl lg:text-3xl font-bold font-mono-tech text-slate-100 tracking-tight">
        {metrics.healthScore}
      </span>
      <span class="text-sm font-semibold text-emerald-400">%</span>
    </div>

    <!-- Mini Progress Gauge -->
    <div class="w-full bg-slate-800/80 rounded-full h-1.5 overflow-hidden">
      <div id="metric-health-bar" class="bg-gradient-to-r from-emerald-500 to-cyan-400 h-full rounded-full transition-all duration-500" style={`width: ${metrics.healthScore}%`}></div>
    </div>
    
    <div class="mt-2 text-[10px] text-slate-400 font-mono-tech flex justify-between">
      <span>INDEX SCORE</span>
      <span class="text-slate-400">TARGET &gt;90%</span>
    </div>
  </div>

  <!-- 2. ENGINE RPM -->
  <div class="relative overflow-hidden rounded-lg bg-[#0d1322] border border-slate-800 p-3.5 flex flex-col justify-between hover:border-cyan-500/40 transition-all duration-300 group shadow-sm">
    <div class="flex items-center justify-between gap-1 text-[11px] font-mono-tech text-slate-400">
      <span class="tracking-wide">ENGINE RPM</span>
      <span class="text-[10px] text-cyan-400/90 bg-cyan-950/40 px-1 rounded border border-cyan-500/20">TACH</span>
    </div>
    
    <div class="my-2 flex items-baseline gap-1.5">
      <span id="metric-rpm-val" class="text-2xl lg:text-3xl font-bold font-mono-tech text-cyan-400 tracking-tight">
        {metrics.rpm.toLocaleString()}
      </span>
      <span class="text-xs text-slate-400 font-mono-tech">RPM</span>
    </div>

    <div class="w-full bg-slate-800/80 rounded-full h-1.5 overflow-hidden">
      <div id="metric-rpm-bar" class="bg-cyan-400 h-full rounded-full transition-all duration-500" style="width: 76%"></div>
    </div>

    <div class="mt-2 text-[10px] text-slate-400 font-mono-tech flex justify-between">
      <span>NOMINAL:</span>
      <span class="text-slate-400">{metrics.rpmNominal}</span>
    </div>
  </div>

  <!-- 3. ENGINE TEMPERATURE -->
  <div class="relative overflow-hidden rounded-lg bg-[#0d1322] border border-slate-800 p-3.5 flex flex-col justify-between hover:border-cyan-500/40 transition-all duration-300 group shadow-sm">
    <div class="flex items-center justify-between gap-1 text-[11px] font-mono-tech text-slate-400">
      <span class="tracking-wide">ENGINE TEMP</span>
      <span id="metric-temp-badge" class="text-[10px] text-emerald-400/90 bg-emerald-950/40 px-1 rounded border border-emerald-500/20">CHT-1</span>
    </div>
    
    <div class="my-2 flex items-baseline gap-1.5">
      <span id="metric-temp-val" class="text-2xl lg:text-3xl font-bold font-mono-tech text-slate-100 tracking-tight">
        {metrics.temperature}
      </span>
      <span class="text-xs text-slate-400 font-mono-tech">°C</span>
    </div>

    <div class="w-full bg-slate-800/80 rounded-full h-1.5 overflow-hidden">
      <div id="metric-temp-bar" class="bg-amber-400 h-full rounded-full transition-all duration-500" style="width: 62%"></div>
    </div>

    <div class="mt-2 text-[10px] text-slate-400 font-mono-tech flex justify-between">
      <span>LIMIT &lt;95°C</span>
      <span class="text-slate-400">{metrics.temperatureNominal}</span>
    </div>
  </div>

  <!-- 4. OIL PRESSURE -->
  <div class="relative overflow-hidden rounded-lg bg-[#0d1322] border border-slate-800 p-3.5 flex flex-col justify-between hover:border-cyan-500/40 transition-all duration-300 group shadow-sm">
    <div class="flex items-center justify-between gap-1 text-[11px] font-mono-tech text-slate-400">
      <span class="tracking-wide">OIL PRESSURE</span>
      <span class="text-[10px] text-blue-400/90 bg-blue-950/40 px-1 rounded border border-blue-500/20">LUB</span>
    </div>
    
    <div class="my-2 flex items-baseline gap-1.5">
      <span id="metric-oil-val" class="text-2xl lg:text-3xl font-bold font-mono-tech text-slate-100 tracking-tight">
        {metrics.oilPressure}
      </span>
      <span class="text-xs text-slate-400 font-mono-tech">bar</span>
    </div>

    <div class="w-full bg-slate-800/80 rounded-full h-1.5 overflow-hidden">
      <div id="metric-oil-bar" class="bg-blue-400 h-full rounded-full transition-all duration-500" style="width: 71%"></div>
    </div>

    <div class="mt-2 text-[10px] text-slate-400 font-mono-tech flex justify-between">
      <span>CRANKCASE</span>
      <span class="text-slate-400">{metrics.oilPressureNominal}</span>
    </div>
  </div>

  <!-- 5. VIBRATION -->
  <div class="relative overflow-hidden rounded-lg bg-[#0d1322] border border-slate-800 p-3.5 flex flex-col justify-between hover:border-cyan-500/40 transition-all duration-300 group shadow-sm">
    <div class="flex items-center justify-between gap-1 text-[11px] font-mono-tech text-slate-400">
      <span class="tracking-wide">VIBRATION</span>
      <span id="metric-vib-badge" class="text-[10px] text-teal-400/90 bg-teal-950/40 px-1 rounded border border-teal-500/20">ACCEL</span>
    </div>
    
    <div class="my-2 flex items-baseline gap-1.5">
      <span id="metric-vib-val" class="text-2xl lg:text-3xl font-bold font-mono-tech text-slate-100 tracking-tight">
        {metrics.vibration}
      </span>
      <span class="text-xs text-slate-400 font-mono-tech">mm/s</span>
    </div>

    <div class="w-full bg-slate-800/80 rounded-full h-1.5 overflow-hidden">
      <div id="metric-vib-bar" class="bg-teal-400 h-full rounded-full transition-all duration-500" style="width: 40%"></div>
    </div>

    <div class="mt-2 text-[10px] text-slate-400 font-mono-tech flex justify-between">
      <span>RMS 3-AXIS</span>
      <span class="text-slate-400">{metrics.vibrationNominal}</span>
    </div>
  </div>

  <!-- 6. FUEL CONSUMPTION -->
  <div class="relative overflow-hidden rounded-lg bg-[#0d1322] border border-slate-800 p-3.5 flex flex-col justify-between hover:border-cyan-500/40 transition-all duration-300 group shadow-sm">
    <div class="flex items-center justify-between gap-1 text-[11px] font-mono-tech text-slate-400">
      <span class="tracking-wide">FUEL FLOW</span>
      <span class="text-[10px] text-amber-400/90 bg-amber-950/40 px-1 rounded border border-amber-500/20">FLOW</span>
    </div>
    
    <div class="my-2 flex items-baseline gap-1.5">
      <span id="metric-fuel-val" class="text-2xl lg:text-3xl font-bold font-mono-tech text-slate-100 tracking-tight">
        {metrics.fuelConsumption}
      </span>
      <span class="text-xs text-slate-400 font-mono-tech">L/h</span>
    </div>

    <div class="w-full bg-slate-800/80 rounded-full h-1.5 overflow-hidden">
      <div id="metric-fuel-bar" class="bg-indigo-400 h-full rounded-full transition-all duration-500" style="width: 55%"></div>
    </div>

    <div class="mt-2 text-[10px] text-slate-400 font-mono-tech flex justify-between">
      <span>CRUISE ECON</span>
      <span class="text-slate-400">{metrics.fuelNominal}</span>
    </div>
  </div>

</section>

<script>
  import type { EngineState } from '../data/engineSimulator';

  const healthVal = document.getElementById('metric-health-val');
  const healthStatus = document.getElementById('metric-health-status');
  const healthBar = document.getElementById('metric-health-bar');
  const rpmVal = document.getElementById('metric-rpm-val');
  const rpmBar = document.getElementById('metric-rpm-bar');
  const tempVal = document.getElementById('metric-temp-val');
  const tempBar = document.getElementById('metric-temp-bar');
  const tempBadge = document.getElementById('metric-temp-badge');
  const oilVal = document.getElementById('metric-oil-val');
  const oilBar = document.getElementById('metric-oil-bar');
  const vibVal = document.getElementById('metric-vib-val');
  const vibBar = document.getElementById('metric-vib-bar');
  const vibBadge = document.getElementById('metric-vib-badge');
  const fuelVal = document.getElementById('metric-fuel-val');
  const fuelBar = document.getElementById('metric-fuel-bar');

  function statusBadgeClass(status: string): string {
    if (status === 'HEALTHY') return 'px-1.5 py-0.2 rounded text-[10px] font-bold bg-emerald-950/60 text-emerald-400 border border-emerald-500/30';
    if (status === 'ADVISORY' || status === 'WARNING') return 'px-1.5 py-0.2 rounded text-[10px] font-bold bg-amber-950/60 text-amber-400 border border-amber-500/30';
    return 'px-1.5 py-0.2 rounded text-[10px] font-bold bg-rose-950/60 text-rose-400 border border-rose-500/30';
  }

  document.addEventListener('engine-state-update', ((e: CustomEvent<EngineState>) => {
    const s = e.detail;

    // Health
    if (healthVal) healthVal.textContent = String(s.healthScore);
    if (healthStatus) {
      healthStatus.textContent = s.engineStatus;
      healthStatus.className = statusBadgeClass(s.engineStatus);
    }
    if (healthBar) healthBar.style.width = `${s.healthScore}%`;

    // RPM
    if (rpmVal) rpmVal.textContent = s.rpm.toLocaleString();
    if (rpmBar) rpmBar.style.width = `${Math.round(((s.rpm - 3000) / 3500) * 100)}%`;

    // Temperature
    if (tempVal) tempVal.textContent = String(s.temperature);
    if (tempBar) {
      const tempPct = Math.round(((s.temperature - 40) / 110) * 100);
      tempBar.style.width = `${tempPct}%`;
      if (s.temperature > 95) {
        tempBar.className = 'bg-rose-500 h-full rounded-full transition-all duration-500';
      } else if (s.temperature > 85) {
        tempBar.className = 'bg-amber-400 h-full rounded-full transition-all duration-500';
      } else {
        tempBar.className = 'bg-amber-400 h-full rounded-full transition-all duration-500';
      }
    }
    if (tempBadge) {
      if (s.temperature > 95) {
        tempBadge.className = 'text-[10px] text-rose-400/90 bg-rose-950/40 px-1 rounded border border-rose-500/20';
        tempBadge.textContent = 'HOT';
      } else if (s.temperature > 85) {
        tempBadge.className = 'text-[10px] text-amber-400/90 bg-amber-950/40 px-1 rounded border border-amber-500/20';
        tempBadge.textContent = 'WARM';
      } else {
        tempBadge.className = 'text-[10px] text-emerald-400/90 bg-emerald-950/40 px-1 rounded border border-emerald-500/20';
        tempBadge.textContent = 'CHT-1';
      }
    }

    // Oil Pressure
    if (oilVal) oilVal.textContent = String(s.oilPressure);
    if (oilBar) {
      const oilPct = Math.round(((s.oilPressure - 0.5) / 5.5) * 100);
      oilBar.style.width = `${oilPct}%`;
      if (s.oilPressure < 2.5) {
        oilBar.className = 'bg-rose-500 h-full rounded-full transition-all duration-500';
      } else if (s.oilPressure < 3.5) {
        oilBar.className = 'bg-amber-400 h-full rounded-full transition-all duration-500';
      } else {
        oilBar.className = 'bg-blue-400 h-full rounded-full transition-all duration-500';
      }
    }

    // Vibration
    if (vibVal) vibVal.textContent = String(s.vibration);
    if (vibBar) {
      const vibPct = Math.round(((s.vibration - 0.3) / 7.7) * 100);
      vibBar.style.width = `${vibPct}%`;
      if (s.vibration > 3.5) {
        vibBar.className = 'bg-rose-500 h-full rounded-full transition-all duration-500';
      } else if (s.vibration > 2.0) {
        vibBar.className = 'bg-amber-400 h-full rounded-full transition-all duration-500';
      } else {
        vibBar.className = 'bg-teal-400 h-full rounded-full transition-all duration-500';
      }
    }
    if (vibBadge) {
      if (s.vibration > 3.5) {
        vibBadge.className = 'text-[10px] text-rose-400/90 bg-rose-950/40 px-1 rounded border border-rose-500/20';
        vibBadge.textContent = 'HIGH';
      } else if (s.vibration > 2.0) {
        vibBadge.className = 'text-[10px] text-amber-400/90 bg-amber-950/40 px-1 rounded border border-amber-500/20';
        vibBadge.textContent = 'ELEVATED';
      } else {
        vibBadge.className = 'text-[10px] text-teal-400/90 bg-teal-950/40 px-1 rounded border border-teal-500/20';
        vibBadge.textContent = 'ACCEL';
      }
    }

    // Fuel Flow
    if (fuelVal) fuelVal.textContent = String(s.fuelFlow);
    if (fuelBar) {
      const fuelPct = Math.round(((s.fuelFlow - 1.0) / 5.0) * 100);
      fuelBar.style.width = `${fuelPct}%`;
    }
  }) as EventListener);
</script>
