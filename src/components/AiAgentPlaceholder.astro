      if (bargeInBtn) {
        bargeInBtn.classList.add('hidden');
        bargeInBtn.classList.remove('flex');
      }
    } else if (state === 'speaking') {
      badgeEl.className += 'bg-purple-950/70 border border-purple-500/50 text-purple-300 shadow-[0_0_12px_rgba(168,85,247,0.3)]';
      badgeDot.className += 'bg-purple-400 animate-pulse';
      badgeText.textContent = '🔊 Speaking (TTS)';
      if (bargeInBtn) {
        bargeInBtn.classList.remove('hidden');
        bargeInBtn.classList.add('flex');
      }
    }

    window.dispatchEvent(new CustomEvent('voice-state-changed', { detail: { state } }));
  }

  function stopSpeaking() {
    if (currentAudio) {
      currentAudio.pause();
      currentAudio.currentTime = 0;
      currentAudio = null;
    }
    if (typeof window !== 'undefined' && 'speechSynthesis' in window) {
      window.speechSynthesis.cancel();
    }
    setVoiceBadgeState('ready');
  }

  async function speakResponse(text: string) {
    if (isMuted || !text) {
      setVoiceBadgeState('ready');
      return;
    }

    stopSpeaking();
    setVoiceBadgeState('speaking');

    try {
      let cleanText = text;
      const spokenMatch = text.match(/\[SPOKEN\]([\s\S]*?)(?:\[VISUAL\]|$)/i);
      if (spokenMatch) {
        cleanText = spokenMatch[1].trim();
      } else {
        cleanText = cleanText.replace(/\[VISUAL\][\s\S]*/i, '').trim();
      }
      cleanText = cleanText.replace(/[*#`_\[\]]/g, ' ').replace(/\s+/g, ' ').trim();

      if (!cleanText) {
        setVoiceBadgeState('ready');
        return;
      }

      const response = await fetch('/api/voice/speak', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ text: cleanText }),
      });

      const contentType = response.headers.get('Content-Type') || '';
      if (response.ok && contentType.includes('audio/mpeg')) {
        const audioBlob = await response.blob();
        const audioUrl = URL.createObjectURL(audioBlob);
        const audio = new Audio(audioUrl);
        currentAudio = audio;

        audio.onended = () => {
          URL.revokeObjectURL(audioUrl);
          currentAudio = null;
          setVoiceBadgeState('ready');
        };

        audio.onerror = () => {
          fallbackSpeech(cleanText);
        };

        await audio.play();
      } else {
        fallbackSpeech(cleanText);
      }
    } catch {
      fallbackSpeech(text);
    }
  }

  function fallbackSpeech(text: string) {
    if (isMuted || typeof window === 'undefined' || !('speechSynthesis' in window)) {
      setVoiceBadgeState('ready');
      return;
    }

    const clean = text.replace(/[*#`_\[\]]/g, ' ').replace(/\s+/g, ' ').trim();
    const utterance = new SpeechSynthesisUtterance(clean);
    utterance.rate = 1.05;
    utterance.pitch = 1.0;

    utterance.onend = () => {
      setVoiceBadgeState('ready');
    };
    utterance.onerror = () => {
      setVoiceBadgeState('ready');
    };

    window.speechSynthesis.speak(utterance);
  }
