---
// DigitalTwinViewer.astro - Core Visual Centerpiece
---

<div class="relative rounded-xl bg-[#0a0f1d] border border-cyan-500/30 overflow-hidden shadow-[0_0_30px_rgba(6,182,212,0.08)] flex flex-col" id="digital-twin">
  
  <!-- Top Bar: Technical Header & Status Badge -->
  <div class="flex flex-wrap items-center justify-between gap-3 px-4 py-3 border-b border-slate-800/80 bg-[#0d1424]/90 z-20">
    <div class="flex items-center gap-2.5">
      <div class="flex items-center justify-center w-6 h-6 rounded bg-cyan-950/70 border border-cyan-500/40 text-cyan-400">
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-sm font-bold tracking-wider uppercase font-mono-tech text-slate-200">
            AERO ENGINE DIGITAL TWIN REPLICA
          </h2>
          <span class="text-[10px] font-mono-tech px-1.5 py-0.2 rounded bg-cyan-950 text-cyan-300 border border-cyan-500/30">
            ISOMETRIC SCHEMATIC
          </span>
        </div>
        <div class="text-[11px] text-slate-400 font-mono-tech">
          SYNCHRONIZED WITH TELEMETRY STREAM // CAD: 4-CYL BOXER AERO-PISTON
        </div>
      </div>
    </div>

    <!-- Core Status Indicator -->
    <div class="flex items-center gap-2.5">
      <div id="twin-status-pill" class="flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-950/50 border border-emerald-500/40 text-emerald-300 text-xs font-mono-tech font-semibold tracking-wider shadow-[0_0_12px_rgba(16,185,129,0.15)] transition-colors">
        <span id="twin-status-dot" class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
        <span id="twin-status-text">ENGINE STATUS: HEALTHY</span>
      </div>

      <!-- View Controls -->
      <div class="hidden sm:flex items-center gap-1 bg-slate-900/90 p-1 rounded border border-slate-800 text-[10px] font-mono-tech text-slate-400">
        <button id="btn-mode-wireframe" class="px-2 py-0.5 rounded text-cyan-400 bg-cyan-950/60 border border-cyan-500/30 hover:text-cyan-300">
          SCHEMATIC
        </button>
        <button id="btn-mode-thermal" class="px-2 py-0.5 rounded text-slate-400 hover:text-slate-200 hover:bg-slate-800">
          THERMAL
        </button>
      </div>
    </div>
  </div>

  <!-- Main Canvas / Engine Schematic Viewport -->
  <div class="relative w-full h-[420px] sm:h-[460px] lg:h-[500px] flex items-center justify-center p-4 overflow-hidden bg-gradient-to-b from-[#090e1c] via-[#070b16] to-[#060911]">
    
    <!-- Background Technical Grid & Radar Sweep -->
    <div class="absolute inset-0 tech-grid-bg opacity-40 pointer-events-none"></div>
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none opacity-25">
      <div class="w-[500px] h-[500px] rounded-full border border-cyan-500/20 radar-sweep"></div>
      <div class="w-[340px] h-[340px] rounded-full border border-dashed border-cyan-500/30 absolute"></div>
      <div class="w-[180px] h-[180px] rounded-full border border-cyan-500/20 absolute"></div>
    </div>

    <!-- Technical HUD Crosshairs and Coordinates -->
    <div class="absolute top-3 left-4 text-[10px] font-mono-tech text-slate-400 flex flex-col gap-0.5 pointer-events-none">
      <span>GRID: 24.819° N / 77.412° E</span>
      <span>ALT: 2,400 m MSL</span>
      <span>AIRSPEED: 140 kts</span>
    </div>
    <div class="absolute top-3 right-4 text-[10px] font-mono-tech text-slate-400 text-right flex flex-col gap-0.5 pointer-events-none">
      <span>FOV: 45° ORTHO</span>
      <span>CAN ID: 0x1F2A</span>
      <span>SYNC LAG: &lt;4ms</span>
    </div>
    
    <!-- Corner HUD Crop Marks -->
    <div class="absolute top-2 left-2 w-3 h-3 border-t-2 border-l-2 border-cyan-500/60 pointer-events-none"></div>
    <div class="absolute top-2 right-2 w-3 h-3 border-t-2 border-r-2 border-cyan-500/60 pointer-events-none"></div>
    <div class="absolute bottom-2 left-2 w-3 h-3 border-b-2 border-l-2 border-cyan-500/60 pointer-events-none"></div>
    <div class="absolute bottom-2 right-2 w-3 h-3 border-b-2 border-r-2 border-cyan-500/60 pointer-events-none"></div>

    <!-- High-Fidelity SVG Engine Schematic -->
    <div class="relative z-10 w-full max-w-[620px] aspect-[4/3] flex items-center justify-center select-none" id="schematic-container">
      <svg class="w-full h-full drop-shadow-[0_0_25px_rgba(6,182,212,0.18)]" viewBox="0 0 800 600" fill="none" xmlns="http://www.w3.org/2000/svg">
        
        <defs>
          <!-- Blueprint Gradients -->
          <linearGradient id="crankGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#1e293b"/>
            <stop offset="50%" stop-color="#0f172a"/>
            <stop offset="100%" stop-color="#090d16"/>
          </linearGradient>

          <linearGradient id="cylGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#0f172a"/>
            <stop offset="30%" stop-color="#1e293b"/>
            <stop offset="70%" stop-color="#1e293b"/>
            <stop offset="100%" stop-color="#0f172a"/>
          </linearGradient>

          <radialGradient id="combustionGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.8"/>
            <stop offset="60%" stop-color="#0284c7" stop-opacity="0.2"/>
            <stop offset="100%" stop-color="#0284c7" stop-opacity="0"/>
          </radialGradient>

          <radialGradient id="thermalGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#f97316" stop-opacity="0.7"/>
            <stop offset="70%" stop-color="#e11d48" stop-opacity="0.25"/>
            <stop offset="100%" stop-color="#991b1b" stop-opacity="0"/>
          </radialGradient>

          <linearGradient id="cyanStrokeGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#38bdf8"/>
            <stop offset="100%" stop-color="#06b6d4"/>
          </linearGradient>
        </defs>

        <!-- Technical CAD Center Reference Marks -->
        <line x1="400" y1="40" x2="400" y2="560" stroke="#334155" stroke-dasharray="4 4" stroke-width="1"/>
        <line x1="100" y1="300" x2="700" y2="300" stroke="#334155" stroke-dasharray="4 4" stroke-width="1"/>
        <circle cx="400" cy="300" r="140" stroke="#1e293b" stroke-dasharray="6 4" stroke-width="1.5"/>

        <!-- ================= CRANKCASE (CENTRAL HOUSING) ================= -->
        <g id="engine-crankcase">
          <!-- Main Sump & Split Crankcase Geometry -->
          <rect x="310" y="190" width="180" height="220" rx="20" fill="url(#crankGrad)" stroke="#38bdf8" stroke-width="2.5"/>
          <rect x="330" y="210" width="140" height="180" rx="14" fill="#080c14" stroke="#1e293b" stroke-width="1.5"/>
          
          <!-- Crankshaft Counterweight & Central Journal Rotator -->
          <circle cx="400" cy="300" r="64" fill="#0f172a" stroke="#0284c7" stroke-width="2"/>
          <circle cx="400" cy="300" r="42" fill="#020617" stroke="#38bdf8" stroke-width="1.5"/>
          
          <!-- Animated Crankshaft Sprocket -->
          <g class="crank-rotation origin-[400px_300px]">
            <animateTransform attributeName="transform" type="rotate" from="0 400 300" to="360 400 300" dur="2.4s" repeatCount="indefinite"/>
            <circle cx="400" cy="275" r="12" fill="#38bdf8" fill-opacity="0.9"/>
            <line x1="400" y1="300" x2="400" y2="275" stroke="#38bdf8" stroke-width="4"/>
            <line x1="380" y1="300" x2="420" y2="300" stroke="#0ea5e9" stroke-width="2"/>
            <line x1="400" y1="280" x2="400" y2="320" stroke="#0ea5e9" stroke-width="2"/>
          </g>

          <!-- Propeller Shaft Flange (Front Output) -->
          <rect x="375" y="140" width="50" height="50" rx="6" fill="#1e293b" stroke="#38bdf8" stroke-width="1.5"/>
          <line x1="400" y1="140" x2="400" y2="100" stroke="#38bdf8" stroke-width="6" stroke-linecap="round"/>
          <circle cx="400" cy="95" r="16" fill="#0369a1" stroke="#38bdf8" stroke-width="2"/>
          <text x="400" y="80" text-anchor="middle" fill="#38bdf8" font-family="monospace" font-size="10" font-weight="bold">PROP FLANGE</text>
        </g>

        <!-- ================= LEFT CYLINDER BANK (CYL 1 & 3) ================= -->
        <g id="cylinder-bank-left">
          <!-- Cylinder 1 Barrel -->
          <rect x="150" y="210" width="160" height="80" rx="6" fill="url(#cylGrad)" stroke="#38bdf8" stroke-width="2"/>
          <!-- Cooling Fins Cylinder 1 -->
          <line x1="170" y1="195" x2="170" y2="305" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
          <line x1="195" y1="195" x2="195" y2="305" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
          <line x1="220" y1="195" x2="220" y2="305" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
          <line x1="245" y1="195" x2="245" y2="305" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
          <line x1="270" y1="195" x2="270" y2="305" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>

          <!-- Cylinder Head Left 1 -->
          <path d="M 150 210 L 110 220 L 110 280 L 150 290 Z" fill="#1e293b" stroke="#38bdf8" stroke-width="2"/>
          <!-- Spark Plug Left -->
          <rect x="85" y="242" width="25" height="16" rx="2" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5"/>
          <line x1="85" y1="250" x2="65" y2="250" stroke="#f59e0b" stroke-width="2.5"/>
          
          <!-- Combustion Chamber Glow (Fires cyclically) -->
          <circle id="cyl1-flame" cx="130" cy="250" r="28" fill="url(#combustionGlow)">
            <animate attributeName="opacity" values="0.3;0.9;0.3" dur="1.2s" repeatCount="indefinite"/>
          </circle>

          <!-- Piston Reciprocating Assembly -->
          <g>
            <animateTransform attributeName="transform" type="translate" values="0,0; 25,0; 0,0" dur="1.2s" repeatCount="indefinite"/>
            <rect x="160" y="222" width="45" height="56" rx="4" fill="#334155" stroke="#94a3b8" stroke-width="1.5"/>
            <!-- Connecting Rod -->
            <line x1="205" y1="250" x2="360" y2="285" stroke="#64748b" stroke-width="5" stroke-linecap="round"/>
          </g>
          
          <!-- Cylinder Label -->
          <text x="135" y="320" fill="#94a3b8" font-family="monospace" font-size="11" font-weight="bold">CYL 01 [LEFT]</text>
        </g>

        <!-- ================= RIGHT CYLINDER BANK (CYL 2 & 4) ================= -->
        <g id="cylinder-bank-right">
          <!-- Cylinder 2 Barrel -->
          <rect x="490" y="210" width="160" height="80" rx="6" fill="url(#cylGrad)" stroke="#38bdf8" stroke-width="2"/>
          <!-- Cooling Fins Cylinder 2 -->
          <line x1="530" y1="195" x2="530" y2="305" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
          <line x1="555" y1="195" x2="555" y2="305" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
          <line x1="580" y1="195" x2="580" y2="305" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
          <line x1="605" y1="195" x2="605" y2="305" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>
          <line x1="630" y1="195" x2="630" y2="305" stroke="#38bdf8" stroke-width="2" stroke-linecap="round"/>

          <!-- Cylinder Head Right 2 -->
          <path d="M 650 210 L 690 220 L 690 280 L 650 290 Z" fill="#1e293b" stroke="#38bdf8" stroke-width="2"/>
          <!-- Spark Plug Right -->
          <rect x="690" y="242" width="25" height="16" rx="2" fill="#0f172a" stroke="#38bdf8" stroke-width="1.5"/>
          <line x1="715" y1="250" x2="735" y2="250" stroke="#f59e0b" stroke-width="2.5"/>

          <!-- Combustion Chamber Glow Right -->
          <circle id="cyl2-flame" cx="670" cy="250" r="28" fill="url(#combustionGlow)">
            <animate attributeName="opacity" values="0.8;0.2;0.8" dur="1.2s" repeatCount="indefinite"/>
          </circle>

          <!-- Piston Reciprocating Assembly Right -->
          <g>
            <animateTransform attributeName="transform" type="translate" values="0,0; -25,0; 0,0" dur="1.2s" repeatCount="indefinite"/>
            <rect x="595" y="222" width="45" height="56" rx="4" fill="#334155" stroke="#94a3b8" stroke-width="1.5"/>
            <!-- Connecting Rod -->
            <line x1="595" y1="250" x2="440" y2="285" stroke="#64748b" stroke-width="5" stroke-linecap="round"/>
          </g>
          
          <!-- Cylinder Label -->
          <text x="610" y="320" fill="#94a3b8" font-family="monospace" font-size="11" font-weight="bold">CYL 02 [RIGHT]</text>
        </g>

        <!-- ================= INTAKE & EXHAUST MANIFOLDS ================= -->
        <!-- Exhaust Runners (Bottom) -->
        <path d="M 130 290 Q 200 450 340 450 L 460 450 Q 600 450 670 290" stroke="#475569" stroke-width="8" fill="none" stroke-linecap="round"/>
        <path d="M 370 450 L 370 510 L 430 510 L 430 450" stroke="#475569" stroke-width="6" fill="#0f172a"/>
        <text x="400" y="530" text-anchor="middle" fill="#64748b" font-family="monospace" font-size="10">EXHAUST MANIFOLD DUAL TUNED</text>

        <!-- Fuel Injection Rails & Throttle Body (Top) -->
        <line x1="200" y1="160" x2="600" y2="160" stroke="#0ea5e9" stroke-width="3" stroke-dasharray="8 4"/>
        <circle cx="280" cy="160" r="5" fill="#38bdf8"/>
        <circle cx="520" cy="160" r="5" fill="#38bdf8"/>

        <!-- ================= SENSOR CALLOUT PIN 1: RPM (CRANK) ================= -->
        <g class="sensor-node cursor-pointer" id="node-rpm">
          <!-- Leader Line -->
          <polyline points="400,220 400,160 300,110 180,110" stroke="#06b6d4" stroke-width="1.5" stroke-dasharray="3 3"/>
          <circle cx="400" cy="220" r="4" fill="#06b6d4"/>
          <!-- Pulsing Ring -->
          <circle cx="400" cy="220" r="10" stroke="#06b6d4" stroke-width="1.5" fill="none" opacity="0.6">
            <animate attributeName="r" values="4;14;4" dur="2s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.8;0.1;0.8" dur="2s" repeatCount="indefinite"/>
          </circle>
        </g>

        <!-- ================= SENSOR CALLOUT PIN 2: TEMPERATURE ================= -->
        <g class="sensor-node cursor-pointer" id="node-temp">
          <!-- Leader Line to Cyl 1 Head -->
          <polyline points="110,230 70,230 40,180 40,110" stroke="#10b981" stroke-width="1.5" stroke-dasharray="3 3"/>
          <circle cx="110" cy="230" r="4" fill="#10b981"/>
          <!-- Pulsing Ring -->
          <circle cx="110" cy="230" r="10" stroke="#10b981" stroke-width="1.5" fill="none" opacity="0.6">
            <animate attributeName="r" values="4;14;4" dur="2.2s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.8;0.1;0.8" dur="2.2s" repeatCount="indefinite"/>
          </circle>
        </g>

        <!-- ================= SENSOR CALLOUT PIN 3: VIBRATION ================= -->
        <g class="sensor-node cursor-pointer" id="node-vib">
          <!-- Leader Line to Main Bearing -->
          <polyline points="400,380 400,430 620,430 680,480" stroke="#2dd4bf" stroke-width="1.5" stroke-dasharray="3 3"/>
          <circle cx="400" cy="380" r="4" fill="#2dd4bf"/>
          <!-- Pulsing Ring -->
          <circle cx="400" cy="380" r="10" stroke="#2dd4bf" stroke-width="1.5" fill="none" opacity="0.6">
            <animate attributeName="r" values="4;14;4" dur="1.8s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.8;0.1;0.8" dur="1.8s" repeatCount="indefinite"/>
          </circle>
        </g>

        <!-- ================= SENSOR CALLOUT PIN 4: OIL PRESSURE ================= -->
        <g class="sensor-node cursor-pointer" id="node-oil">
          <!-- Leader Line to Sump -->
          <polyline points="460,370 520,370 590,390 680,390" stroke="#3b82f6" stroke-width="1.5" stroke-dasharray="3 3"/>
          <circle cx="460" cy="370" r="4" fill="#3b82f6"/>
          <!-- Pulsing Ring -->
          <circle cx="460" cy="370" r="10" stroke="#3b82f6" stroke-width="1.5" fill="none" opacity="0.6">
            <animate attributeName="r" values="4;14;4" dur="2.4s" repeatCount="indefinite"/>
            <animate attributeName="opacity" values="0.8;0.1;0.8" dur="2.4s" repeatCount="indefinite"/>
          </circle>
        </g>

      </svg>
    </div>

    <!-- ================= 4 FLOATING TELEMETRY SENSOR BADGES ================= -->
    
    <!-- TOP-LEFT: RPM TELEMETRY CALLOUT -->
    <div class="absolute top-8 left-4 sm:left-8 z-30 bg-[#0c1222]/90 border border-cyan-500/40 rounded-lg p-2.5 backdrop-blur-md shadow-[0_0_15px_rgba(6,182,212,0.15)] flex flex-col min-w-[130px] sm:min-w-[150px]">
      <div class="flex items-center justify-between text-[10px] font-mono-tech text-cyan-400">
        <span class="flex items-center gap-1.5 font-bold">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
          CRANK RPM
        </span>
        <span class="text-slate-400">ENC-01</span>
      </div>
      <div class="flex items-baseline gap-1 my-0.5">
        <span id="twin-rpm-display" class="text-xl sm:text-2xl font-bold font-mono-tech text-slate-100">5,200</span>
        <span class="text-[10px] text-cyan-300 font-mono-tech font-semibold">RPM</span>
      </div>
      <div class="text-[9px] text-slate-400 font-mono-tech flex justify-between">
        <span>TACH STABLE</span>
        <span class="text-emerald-400">NOMINAL</span>
      </div>
    </div>

    <!-- BOTTOM-LEFT: TEMPERATURE TELEMETRY CALLOUT -->
    <div class="absolute bottom-8 left-4 sm:left-8 z-30 bg-[#0c1222]/90 border border-emerald-500/40 rounded-lg p-2.5 backdrop-blur-md shadow-[0_0_15px_rgba(16,185,129,0.12)] flex flex-col min-w-[130px] sm:min-w-[150px]">
      <div class="flex items-center justify-between text-[10px] font-mono-tech text-emerald-400">
        <span class="flex items-center gap-1.5 font-bold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          CYL TEMP (CHT)
        </span>
        <span class="text-slate-400">TH-K1</span>
      </div>
      <div class="flex items-baseline gap-1 my-0.5">
        <span id="twin-temp-display" class="text-xl sm:text-2xl font-bold font-mono-tech text-slate-100">78</span>
        <span class="text-[10px] text-emerald-300 font-mono-tech font-semibold">°C</span>
      </div>
      <div class="text-[9px] text-slate-400 font-mono-tech flex justify-between">
        <span>MAX: 95°C</span>
        <span id="twin-temp-status" class="text-emerald-400">HEALTHY</span>
      </div>
    </div>

    <!-- TOP-RIGHT: OIL PRESSURE TELEMETRY CALLOUT -->
    <div class="absolute top-8 right-4 sm:right-8 z-30 bg-[#0c1222]/90 border border-blue-500/40 rounded-lg p-2.5 backdrop-blur-md shadow-[0_0_15px_rgba(59,130,246,0.12)] flex flex-col min-w-[130px] sm:min-w-[150px] text-right">
      <div class="flex items-center justify-between text-[10px] font-mono-tech text-blue-400">
        <span class="text-slate-400">LUB-02</span>
        <span class="flex items-center gap-1.5 font-bold">
          OIL PRESSURE
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-pulse"></span>
        </span>
      </div>
      <div class="flex items-baseline justify-end gap-1 my-0.5">
        <span id="twin-oil-display" class="text-xl sm:text-2xl font-bold font-mono-tech text-slate-100">4.3</span>
        <span class="text-[10px] text-blue-300 font-mono-tech font-semibold">bar</span>
      </div>
      <div class="text-[9px] text-slate-400 font-mono-tech flex justify-between">
        <span id="twin-oil-status" class="text-emerald-400">NORMAL</span>
        <span>SUMP STABLE</span>
      </div>
    </div>

    <!-- BOTTOM-RIGHT: VIBRATION TELEMETRY CALLOUT -->
    <div class="absolute bottom-8 right-4 sm:right-8 z-30 bg-[#0c1222]/90 border border-teal-500/40 rounded-lg p-2.5 backdrop-blur-md shadow-[0_0_15px_rgba(45,212,191,0.12)] flex flex-col min-w-[130px] sm:min-w-[150px] text-right">
      <div class="flex items-center justify-between text-[10px] font-mono-tech text-teal-400">
        <span class="text-slate-400">ACCEL-3X</span>
        <span class="flex items-center gap-1.5 font-bold">
          VIBRATION
          <span class="w-1.5 h-1.5 rounded-full bg-teal-400 animate-pulse"></span>
        </span>
      </div>
      <div class="flex items-baseline justify-end gap-1 my-0.5">
        <span id="twin-vib-display" class="text-xl sm:text-2xl font-bold font-mono-tech text-slate-100">1.2</span>
        <span class="text-[10px] text-teal-300 font-mono-tech font-semibold">mm/s</span>
      </div>
      <div class="text-[9px] text-slate-400 font-mono-tech flex justify-between">
        <span id="twin-vib-status" class="text-emerald-400">LOW RMS</span>
        <span>PEAK 1.4 g</span>
      </div>
    </div>

  </div>

  <!-- Bottom Sub-Bar: Telemetry Status & Architecture Tags -->
  <div class="px-4 py-2 bg-[#090d18] border-t border-slate-800/80 flex flex-wrap items-center justify-between text-[11px] font-mono-tech text-slate-400">
    <div class="flex items-center gap-4">
      <span class="flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        TWIN STATE: <strong class="text-slate-200">REAL-TIME TWIN MESH</strong>
      </span>
      <span class="hidden sm:inline text-slate-600">|</span>
      <span class="hidden sm:inline">
        POWERTRAIN: <strong class="text-slate-300">2-STROKE DUAL-IGNITION</strong>
      </span>
    </div>
    <div class="flex items-center gap-3 text-[10px] text-slate-400">
      <span>SAMPLING: 100 Hz</span>
      <span class="text-cyan-400">DSP FILTER: KALMAN-OK</span>
    </div>
  </div>

</div>

<script>
  // Mode toggles: Schematic vs Thermal
  const btnWireframe = document.getElementById('btn-mode-wireframe');
  const btnThermal = document.getElementById('btn-mode-thermal');
  const cyl1Flame = document.getElementById('cyl1-flame');
  const cyl2Flame = document.getElementById('cyl2-flame');

  btnThermal?.addEventListener('click', () => {
    btnThermal.classList.add('text-cyan-400', 'bg-cyan-950/60', 'border', 'border-cyan-500/30');
    btnThermal.classList.remove('text-slate-400');
    btnWireframe?.classList.remove('text-cyan-400', 'bg-cyan-950/60', 'border', 'border-cyan-500/30');
    btnWireframe?.classList.add('text-slate-400');

    // Switch flame shader to thermal gradient
    cyl1Flame?.setAttribute('fill', 'url(#thermalGlow)');
    cyl2Flame?.setAttribute('fill', 'url(#thermalGlow)');
  });

  btnWireframe?.addEventListener('click', () => {
    btnWireframe.classList.add('text-cyan-400', 'bg-cyan-950/60', 'border', 'border-cyan-500/30');
    btnWireframe.classList.remove('text-slate-400');
    btnThermal?.classList.remove('text-cyan-400', 'bg-cyan-950/60', 'border', 'border-cyan-500/30');
    btnThermal?.classList.add('text-slate-400');

    // Switch flame shader back to combustion cyan glow
    cyl1Flame?.setAttribute('fill', 'url(#combustionGlow)');
    cyl2Flame?.setAttribute('fill', 'url(#combustionGlow)');
  });
</script>
