---
return Astro.redirect('/overview');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content="0;url=/overview" />
    <script is:inline>
      window.location.replace('/overview');
    </script>
    <title>Redirecting to UAV Engine Mission Overview...</title>
  </head>
  <body class="bg-[#070a13] text-slate-400 p-8 font-mono text-xs">
    <p>Redirecting to Mission Console: <a href="/overview" class="text-cyan-400">/overview</a>...</p>
  </body>
</html>
