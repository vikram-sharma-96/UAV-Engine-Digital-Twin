<style>
  /* Radar sweep animation for background ambience */
  .mini-radar-sweep {
    animation: miniRadarSweep 6s linear infinite;
  }
  @keyframes miniRadarSweep {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

<script>
  import type { EngineState } from '../data/engineSimulator';

  const miniStatus = document.getElementById('mini-twin-status');
  const miniRpm = document.getElementById('mini-twin-rpm');
  const miniTemp = document.getElementById('mini-twin-temp');
  const miniRpmVal = document.getElementById('mini-twin-rpm-val');
  const miniTempVal = document.getElementById('mini-twin-temp-val');
  const miniOilVal = document.getElementById('mini-twin-oil-val');
  const miniVibVal = document.getElementById('mini-twin-vib-val');

  document.addEventListener('engine-state-update', ((e: CustomEvent<EngineState>) => {
    const s = e.detail;
    if (miniRpm) miniRpm.textContent = `${s.rpm.toLocaleString()} RPM`;
    if (miniTemp) miniTemp.textContent = `${s.temperature} °C`;
    if (miniRpmVal) miniRpmVal.textContent = s.rpm.toLocaleString();
    if (miniTempVal) miniTempVal.textContent = String(s.temperature);
    if (miniOilVal) miniOilVal.textContent = String(s.oilPressure);
    if (miniVibVal) miniVibVal.textContent = String(s.vibration);
    if (miniStatus) {
      miniStatus.textContent = s.engineStatus;
      if (s.engineStatus === 'HEALTHY') {
        miniStatus.className = 'px-2 py-0.5 rounded text-[10px] font-mono-tech font-bold bg-emerald-950/60 text-emerald-300 border border-emerald-500/30 flex items-center gap-1.5';
      } else if (s.engineStatus === 'ADVISORY' || s.engineStatus === 'WARNING') {
        miniStatus.className = 'px-2 py-0.5 rounded text-[10px] font-mono-tech font-bold bg-amber-950/60 text-amber-300 border border-amber-500/30 flex items-center gap-1.5';
      } else {
        miniStatus.className = 'px-2 py-0.5 rounded text-[10px] font-mono-tech font-bold bg-rose-950/60 text-rose-300 border border-rose-500/30 flex items-center gap-1.5';
      }
    }
  }) as EventListener);
</script>
