---
// AiAgentPlaceholder.astro - AI Engine Health Agent (Ollama Interface Stub)
const suggestedQuestions = [
  "Why is engine health decreasing?",
  "What caused the vibration increase?",
  "What should I inspect?"
];
---

<div class="rounded-xl bg-[#0a0f1d] border border-amber-500/30 p-4 shadow-sm flex flex-col justify-between" id="ai-agent">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-800/80">
    <div class="flex items-center gap-2">
      <div class="p-1 rounded bg-amber-950/60 border border-amber-500/40 text-amber-400">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2a8 8 0 0 0-8 8c0 3.37 2.08 6.26 5 7.42V20a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2v-2.58c2.92-1.16 5-4.05 5-7.42a8 8 0 0 0-8-8z"></path>
          <line x1="9" y1="10" x2="9.01" y2="10"></line>
          <line x1="15" y1="10" x2="15.01" y2="10"></line>
          <path d="M10 14h4"></path>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200">
            AI ENGINE HEALTH AGENT
          </h3>
          <span class="text-[9px] font-mono-tech px-1.5 py-0.2 rounded bg-amber-950/80 text-amber-300 border border-amber-500/40">
            OLLAMA ARCHITECTURE
          </span>
        </div>
        <p class="text-[11px] text-slate-400 font-mono-tech">
          NATURAL LANGUAGE TELEMETRY REASONING & ROOT CAUSE ANALYSIS
        </p>
      </div>
    </div>

    <!-- Offline Status Badge -->
    <div class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-amber-950/50 border border-amber-500/30 text-amber-400 text-xs font-mono-tech">
      <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
      <span class="font-semibold">AI Agent Offline — Integration Pending</span>
    </div>
  </div>

  <!-- Terminal Chat Mock Area -->
  <div class="my-3 rounded-lg bg-[#070b14] border border-slate-800/80 p-3.5 space-y-3 font-mono-tech">
    <!-- Notice Banner -->
    <div class="flex items-start gap-2.5 p-2.5 rounded bg-slate-900/80 border border-slate-800 text-[11px] text-slate-300">
      <svg class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="16" x2="12" y2="12"></line>
        <line x1="12" y1="8" x2="12.01" y2="8"></line>
      </svg>
      <div>
        <span class="text-cyan-400 font-semibold">OLLAMA INTEGRATION PREVIEW:</span> The AI Reasoning Copilot will ingest real-time CAN-bus telemetry, FFT vibration spectrums, and thermal gradients via local Ollama models (e.g., Llama 3 / Mistral) for real-time pilot and technician advisory.
      </div>
    </div>

    <!-- Suggested Questions Prompt Chips -->
    <div>
      <div class="text-[10px] text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>Suggested Diagnostics Queries</span>
        <span>CLICK TO PREVIEW</span>
      </div>
      <div class="flex flex-wrap gap-2">
        {suggestedQuestions.map((q) => (
          <button 
            type="button"
            class="suggested-q-btn text-xs px-2.5 py-1.5 rounded-md bg-[#0d1424] hover:bg-cyan-950/40 text-cyan-300 border border-cyan-500/30 hover:border-cyan-400 transition-colors text-left flex items-center gap-1.5"
            data-query={q}
          >
            <span class="text-cyan-500">›</span>
            <span>"{q}"</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Disabled Chat Input Group -->
    <div class="relative pt-1">
      <div class="flex items-center gap-2">
        <div class="relative flex-1">
          <input 
            type="text" 
            id="ai-agent-input"
            disabled
            placeholder="Ask AI Engine Copilot... (Ollama connection disabled in visual preview)"
            class="w-full px-3 py-2 text-xs bg-slate-950 text-slate-400 rounded-md border border-slate-800 font-mono-tech placeholder:text-slate-600 cursor-not-allowed select-none"
          />
          <div class="absolute right-2 top-2 text-[10px] text-slate-600">
            OFFLINE
          </div>
        </div>
        
        <button 
          type="button" 
          disabled
          class="px-4 py-2 rounded-md bg-slate-800 text-slate-500 font-mono-tech text-xs font-semibold cursor-not-allowed border border-slate-700/60 flex items-center gap-1.5"
        >
          <span>SEND</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </div>

      <div id="ai-query-feedback" class="hidden mt-2 p-2 rounded bg-cyan-950/30 border border-cyan-500/30 text-[11px] text-cyan-300">
        <!-- Dynamic query preview injected via JS -->
      </div>
    </div>
  </div>

  <!-- Footer Info -->
  <div class="pt-2 border-t border-slate-800/60 flex items-center justify-between text-[10px] font-mono-tech text-slate-400">
    <span>ENGINE COGNITION: LLAMA-3-7B-INSTRUCT</span>
    <span class="text-amber-400">STATUS: OLLAMA DAEMON PENDING</span>
  </div>
</div>

<script>
  const queryBtns = document.querySelectorAll('.suggested-q-btn');
  const feedbackEl = document.getElementById('ai-query-feedback');
  const inputEl = document.getElementById('ai-agent-input') as HTMLInputElement;

  queryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const q = btn.getAttribute('data-query');
      if (inputEl && q) {
        inputEl.value = q;
      }
      if (feedbackEl && q) {
        feedbackEl.classList.remove('hidden');
        feedbackEl.innerHTML = `
          <div class="flex items-center gap-1.5 font-bold mb-1 text-cyan-200">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
            Simulated Query Received: "${q}"
          </div>
          <div class="text-slate-300 text-[10px]">
            [Ollama Prompt Template Prepared] Engine Telemetry Vector: [Health: 94%, RPM: 5200, Temp: 78°C, Vib: 1.2mm/s]. When Ollama is booted, response generation will stream directly here.
          </div>
        `;
      }
    });
  });
</script>
