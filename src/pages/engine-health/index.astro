---
import Layout from '../../layouts/Layout.astro';
import EngineHealthPanel from '../../components/EngineHealthPanel.astro';
---

<Layout 
	title="Engine Health | UAV Aero Engine Digital Twin" 
	description="Dedicated Engine Health Monitoring & Subsystem Degradation Diagnostics"
	activeRoute="/engine-health"
>
	<!-- Page Header Banner -->
	<div class="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-xl bg-[#0a0f1e]/90 border border-slate-800/90 shadow-sm">
		<div>
			<div class="flex items-center gap-2">
				<span class="text-xs font-mono-tech font-bold text-emerald-400 uppercase tracking-wider">
					ENGINE HEALTH MONITORING CONSOLE
				</span>
				<span class="text-slate-600">|</span>
				<span class="text-xs font-mono-tech text-slate-400">
					KALMAN MULTI-SENSOR FUSION INDEX
				</span>
			</div>
			<h2 class="text-sm sm:text-base font-semibold text-slate-100 mt-0.5">
				Subsystem Integrity, Thermal Balance & Component Degradation Metrics
			</h2>
		</div>

		<div class="flex items-center gap-2 text-xs font-mono-tech">
			<div class="px-2.5 py-1 rounded bg-emerald-950/50 border border-emerald-500/30 text-emerald-300 font-semibold flex items-center gap-1.5">
				<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
				STATUS: NOMINAL INTEGRITY
			</div>
		</div>
	</div>

	<!-- Main Subsystem Health Panel (Radial Gauge + 5 Subsystem Scores) -->
	<EngineHealthPanel />

	<!-- Health Degradation Trend & Subsystem Analysis Grid -->
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
		
		<!-- 1. Health Degradation Trend Card -->
		<div class="rounded-xl bg-[#0a0f1d] border border-slate-800/90 p-4 shadow-sm flex flex-col justify-between">
			<div class="flex items-center justify-between pb-2.5 border-b border-slate-800/80">
				<div class="flex items-center gap-2">
					<div class="p-1 rounded bg-emerald-950/60 border border-emerald-500/30 text-emerald-400">
						<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
							<polyline points="17 6 23 6 23 12"></polyline>
						</svg>
					</div>
					<div>
						<h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200">
							HISTORICAL HEALTH TREND (150 HRS)
						</h3>
						<p class="text-[10px] text-slate-400 font-mono-tech">
							DEGRADATION RATE: -0.024% PER FLIGHT HOUR
						</p>
					</div>
				</div>
				<span class="text-[10px] font-mono-tech text-emerald-400 bg-emerald-950/40 px-2 py-0.5 rounded border border-emerald-500/20">
					STABLE
				</span>
			</div>

			<!-- Trend SVG Curve -->
			<div class="relative w-full h-[120px] my-3">
				<svg class="w-full h-full" viewBox="0 0 400 120" preserveAspectRatio="none">
					<defs>
						<linearGradient id="healthTrendGrad" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0%" stop-color="#10b981" stop-opacity="0.3"/>
							<stop offset="100%" stop-color="#10b981" stop-opacity="0"/>
						</linearGradient>
					</defs>
					
					<!-- Warning threshold line at 80% -->
					<line x1="0" y1="70" x2="400" y2="70" stroke="#f59e0b" stroke-width="1" stroke-dasharray="4 4" opacity="0.6"/>
					<text x="330" y="65" fill="#f59e0b" font-family="monospace" font-size="9" opacity="0.8">LIMIT 80%</text>

					<!-- Health Curve Area & Line -->
					<path d="M 0,20 Q 100,22 200,28 T 350,35 L 400,38 L 400,120 L 0,120 Z" fill="url(#healthTrendGrad)" />
					<path d="M 0,20 Q 100,22 200,28 T 350,35 L 400,38" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" />
					
					<!-- Current point marker -->
					<circle cx="395" cy="38" r="4" fill="#10b981" class="animate-ping" opacity="0.75" />
					<circle cx="395" cy="38" r="4" fill="#10b981" />
				</svg>
			</div>

			<div class="pt-2 border-t border-slate-800/60 flex items-center justify-between text-[10px] font-mono-tech text-slate-400">
				<span>0.0 HRS (100% HEALTH)</span>
				<span class="text-slate-500">CURRENT: 142.8 HRS (94%)</span>
				<span>500.0 HRS (OVERHAUL)</span>
			</div>
		</div>

		<!-- 2. Subsystem Fault Tolerance & Anomaly Matrix -->
		<div class="rounded-xl bg-[#0a0f1d] border border-slate-800/90 p-4 shadow-sm flex flex-col justify-between">
			<div class="flex items-center justify-between pb-2.5 border-b border-slate-800/80">
				<div class="flex items-center gap-2">
					<div class="p-1 rounded bg-cyan-950/60 border border-cyan-500/30 text-cyan-400">
						<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
						</svg>
					</div>
					<div>
						<h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200">
							SUBSYSTEM MARGIN OF SAFETY
						</h3>
						<p class="text-[10px] text-slate-400 font-mono-tech">
							AVIONICS STRUCTURAL INTEGRITY RESERVES
						</p>
					</div>
				</div>
				<span class="text-[10px] font-mono-tech text-cyan-400 bg-cyan-950/40 px-2 py-0.5 rounded border border-cyan-500/20">
					SAFETY FACTOR 2.4x
				</span>
			</div>

			<div class="space-y-2.5 my-3 font-mono-tech text-xs">
				<div class="flex items-center justify-between p-2 rounded bg-slate-950/50 border border-slate-800/60">
					<div class="flex items-center gap-2">
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
						<span class="text-slate-300">Cylinder Compression Balance</span>
					</div>
					<div class="flex items-center gap-3">
						<span class="text-slate-400">98.2%</span>
						<span class="text-[10px] text-emerald-400 font-bold">OPTIMAL</span>
					</div>
				</div>

				<div class="flex items-center justify-between p-2 rounded bg-slate-950/50 border border-slate-800/60">
					<div class="flex items-center gap-2">
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
						<span class="text-slate-300">Main Journal Bearing Clearance</span>
					</div>
					<div class="flex items-center gap-3">
						<span class="text-slate-400">0.035 mm</span>
						<span class="text-[10px] text-emerald-400 font-bold">WITHIN SPEC</span>
					</div>
				</div>

				<div class="flex items-center justify-between p-2 rounded bg-slate-950/50 border border-slate-800/60">
					<div class="flex items-center gap-2">
						<span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
						<span class="text-slate-300">Oil Viscosity & Shear Stability</span>
					</div>
					<div class="flex items-center gap-3">
						<span class="text-slate-400">14.2 cSt @ 100°C</span>
						<span class="text-[10px] text-cyan-400 font-bold">SAE 20W-50 OK</span>
					</div>
				</div>

				<div class="flex items-center justify-between p-2 rounded bg-slate-950/50 border border-slate-800/60">
					<div class="flex items-center gap-2">
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
						<span class="text-slate-300">Cooling Shroud Airflow Delta-P</span>
					</div>
					<div class="flex items-center gap-3">
						<span class="text-slate-400">1.8 kPa</span>
						<span class="text-[10px] text-emerald-400 font-bold">UNRESTRICTED</span>
					</div>
				</div>
			</div>

			<div class="pt-2 border-t border-slate-800/60 flex items-center justify-between text-[10px] font-mono-tech text-slate-400">
				<span>KALMAN CONFIDENCE: 99.4%</span>
				<span class="text-emerald-400">ANOMALIES DETECTED: ZERO</span>
			</div>
		</div>

	</div>
</Layout>
