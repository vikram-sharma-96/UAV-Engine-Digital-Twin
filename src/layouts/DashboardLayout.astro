---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import SettingsDialog from '../components/SettingsDialog.astro';

interface Props {
  title?: string;
  description?: string;
  channelName?: string;
  channelSubtitle?: string;
}

const {
  title = "AI Digital Twin | UAV Aero Piston Engines",
  description = "AI-Enabled Real-Time Digital Twin System for Health Monitoring & Fault Prediction",
  channelName = "MISSION TELEMETRY CONSOLE",
  channelSubtitle = "AI-Enabled Real-Time Digital Twin System for Health Monitoring & Fault Prediction"
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<Layout title={title} description={description}>
  <!-- Top Command Header -->
  <Header />

  <!-- Main Body Layout: Sidebar + Dashboard Content Viewport -->
  <div class="flex-1 flex flex-col lg:flex-row w-full min-h-[calc(100vh-65px)]">
    
    <!-- Persistent Sidebar Navigation -->
    <Sidebar currentPath={currentPath} />

    <!-- Main Viewport Area (Fitting Screen Height with internal scrolling) -->
    <main class="flex-1 p-4 lg:p-6 space-y-5 overflow-y-auto max-h-[calc(100vh-65px)] flex flex-col justify-between">
      
      <div class="space-y-5">
        <!-- Technical Flight Regime & Channel Banner -->
        <div class="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-xl bg-[#0a0f1e]/90 border border-slate-800/90 shadow-sm shrink-0">
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono-tech font-bold text-cyan-400 uppercase tracking-wider">
                {channelName}
              </span>
              <span class="text-slate-600">|</span>
              <span class="text-xs font-mono-tech text-slate-400">
                SYS-ID: UAV-PT900-X1
              </span>
            </div>
            <h2 class="text-sm sm:text-base font-semibold text-slate-100 mt-0.5">
              {channelSubtitle}
            </h2>
          </div>

          <div class="flex items-center gap-2 text-xs font-mono-tech">
            <div class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300 flex items-center gap-1.5">
              <span class="text-slate-500">FLIGHT REGIME:</span>
              <span class="text-emerald-400 font-bold">ALT 2,400m CRUISE</span>
            </div>
            <div class="hidden sm:flex px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300 items-center gap-1.5">
              <span class="text-slate-500">PROPULSION:</span>
              <span class="text-cyan-400 font-bold">AERO 4-CYL BOXER</span>
            </div>
          </div>
        </div>

        <!-- Dynamic Page View Content Slot -->
        <slot />
      </div>

      <!-- Avionics Operational Footer -->
      <footer class="pt-4 pb-2 border-t border-slate-800/80 text-[11px] font-mono-tech text-slate-400 flex flex-wrap items-center justify-between gap-3 shrink-0">
        <div>
          UAV AERO PISTON ENGINE DIGITAL TWIN &copy; 2026 // AVIONICS HEALTH MONITORING SPEC 4.2
        </div>
        <div class="flex items-center gap-4 text-slate-400">
          <span>CAN-BUS: 1000 kBaud</span>
          <span>FDIR PROTOCOL: MIL-STD-1553B COMPLIANT</span>
          <span class="text-cyan-400">INTERFACE READY</span>
        </div>
      </footer>

    </main>
  </div>

  <!-- Telemetry Settings Dialog -->
  <SettingsDialog />
</Layout>
