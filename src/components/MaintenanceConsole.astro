---
// MaintenanceConsole.astro - Ground-Control Maintenance & Service Operations
interface ComponentCondition {
  component: string;
  subsystem: string;
  hoursLogged: number;
  condition: string;
  status: "OK" | "INSPECT" | "SERVICE";
  wearScore: number;
}

const componentConditions: ComponentCondition[] = [
  { component: "Cylinder Barrels & Piston Rings", subsystem: "Power Section", hoursLogged: 142.8, condition: "Nominal Compression & Sealing", status: "OK", wearScore: 94 },
  { component: "Crankshaft Main & Rod Bearings", subsystem: "Kinematics", hoursLogged: 142.8, condition: "Hydrodynamic Film Intact", status: "OK", wearScore: 92 },
  { component: "Oil Scavenge Pump & Filter Assembly", subsystem: "Lubrication", hoursLogged: 42.8, condition: "Filter Replaced at 100h", status: "OK", wearScore: 96 },
  { component: "Cooling Radiator & Thermal Valve", subsystem: "Thermal Management", hoursLogged: 142.8, condition: "Flow Restriction <2%", status: "OK", wearScore: 95 },
  { component: "Electronic Port Fuel Injectors", subsystem: "Fuel Delivery", hoursLogged: 142.8, condition: "Flow Imbalance <1.2%", status: "OK", wearScore: 91 },
  { component: "Dual CDI Ignition Coils & Harness", subsystem: "Ignition", hoursLogged: 142.8, condition: "Spark Gap Within Spec", status: "OK", wearScore: 93 }
];

const inspectionChecklist = [
  { id: "TASK-B1", title: "Borescope Cylinder Inspection", interval: "Every 100h", dueIn: "57.2 HRS", priority: "ROUTINE", description: "Inspect cylinder cross-hatching, valve seats, and carbon buildup via borescope." },
  { id: "TASK-B2", title: "Oil SOAP Spectrometric Sampling", interval: "Every 50h", dueIn: "7.2 HRS", priority: "MANDATORY", description: "Extract 50ml oil sample for ICP-OES metal wear analysis (Fe, Cu, Al, Cr PPM)." },
  { id: "TASK-B3", title: "Vibration Harmonic FFT Audit", interval: "Every 150h", dueIn: "7.2 HRS", priority: "PREVENTIVE", description: "Measure 1X and 2X rotational orders to verify dynamic crankshaft balance." },
  { id: "TASK-B4", title: "Fuel Rail & Injector Flush", interval: "Every 250h", dueIn: "107.2 HRS", priority: "SCHEDULED", description: "Ultrasonic cleaning and dynamic bench flow verification of 4 injectors." }
];

const maintenanceHistory = [
  { woId: "WO-2026-089", date: "2026-03-10", engineHrs: "100.0 HRS", action: "100-Hr Mandatory Service: Engine oil drain & filter renewal. Valve clearance check.", tech: "TECH-AV-04", status: "SIGNED OFF", severity: "ROUTINE" },
  { woId: "WO-2026-042", date: "2026-02-18", engineHrs: "50.0 HRS", action: "50-Hr Initial Break-in Inspection: Spark plugs cleaned and regapped to 0.6mm.", tech: "TECH-AV-12", status: "SIGNED OFF", severity: "ROUTINE" },
  { woId: "WO-2026-003", date: "2026-01-20", engineHrs: "0.0 HRS", action: "Pre-Flight Acceptance Test: Dyno bench calibration and sensor verification.", tech: "ENG-LEAD-01", status: "CERTIFIED", severity: "PREVENTIVE" }
];
---

<div class="space-y-5">
  
  <!-- Section 1: Maintenance Schedule & TBO Timeline Banner -->
  <div class="rounded-xl bg-[#0a0f1d] border border-slate-800/90 p-4 shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-slate-800/80">
      <div class="flex items-center gap-2">
        <div class="p-1 rounded bg-cyan-950/60 border border-cyan-500/30 text-cyan-400">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        </div>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200">
            MAINTENANCE LIFECYCLE & TBO OVERVIEW
          </h3>
          <p class="text-[11px] text-slate-400 font-mono-tech">
            TIME BEFORE OVERHAUL: 500.0 FLIGHT HOURS // CURRENT TIME: 142.8 HRS
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono-tech">
        <span class="text-slate-400">NEXT DUE:</span>
        <span class="px-2.5 py-0.5 rounded bg-amber-950/50 text-amber-300 border border-amber-500/30 font-bold">
          CYCLE-B (7.2 HRS)
        </span>
      </div>
    </div>

    <!-- TBO Progress Timeline -->
    <div class="mt-4 space-y-2">
      <div class="flex justify-between text-xs font-mono-tech">
        <span class="text-slate-400">Total Life Used: <strong class="text-slate-200">142.8 / 500.0 hrs</strong> (28.5%)</span>
        <span class="text-cyan-400 font-semibold">REMAINING USEFUL LIFE: 357.2 HRS</span>
      </div>
      <div class="w-full bg-slate-900 rounded-full h-2.5 overflow-hidden border border-slate-800">
        <div class="bg-gradient-to-r from-cyan-500 via-teal-400 to-emerald-400 h-full rounded-full" style="width: 28.5%"></div>
      </div>
      <div class="flex justify-between text-[10px] font-mono-tech text-slate-500 pt-1">
        <span>0 HRS (NEW)</span>
        <span class="text-slate-400">50H [DONE]</span>
        <span class="text-slate-400">100H [DONE]</span>
        <span class="text-amber-400 font-bold">150H [7.2H DUE]</span>
        <span>250H MID-TERM</span>
        <span>500H TBO OVERHAUL</span>
      </div>
    </div>
  </div>

  <!-- Section 2: Component Condition Matrix -->
  <div class="rounded-xl bg-[#0a0f1d] border border-slate-800/90 p-4 shadow-sm">
    <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
      <div class="flex items-center gap-2">
        <div class="p-1 rounded bg-teal-950/60 border border-teal-500/30 text-teal-400">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
          </svg>
        </div>
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200">
            ENGINE COMPONENT HEALTH & WEAR AUDIT
          </h3>
          <p class="text-[11px] text-slate-400 font-mono-tech">
            BASED ON AIRWORTHINESS DIRECTIVES (AD) & FAA FAR 33.19 STANDARDS
          </p>
        </div>
      </div>
      <span class="text-[10px] font-mono-tech px-2 py-0.5 rounded bg-emerald-950/40 text-emerald-400 border border-emerald-500/30">
        ALL NOMINAL
      </span>
    </div>

    <div class="my-3 overflow-x-auto rounded-lg border border-slate-800/80 bg-[#0d1424]">
      <table class="w-full text-left text-xs font-mono-tech">
        <thead class="bg-slate-950/80 text-[10px] text-slate-400 uppercase tracking-wider border-b border-slate-800">
          <tr>
            <th class="py-2.5 px-3">Subsystem Assembly</th>
            <th class="py-2.5 px-3">Section</th>
            <th class="py-2.5 px-3">Hrs Logged</th>
            <th class="py-2.5 px-3">Evaluated Condition</th>
            <th class="py-2.5 px-3 text-center">Wear Rating</th>
            <th class="py-2.5 px-3 text-center">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60">
          {componentConditions.map((c) => (
            <tr class="hover:bg-slate-900/60 transition-colors">
              <td class="py-2.5 px-3 text-slate-200 font-semibold">{c.component}</td>
              <td class="py-2.5 px-3 text-slate-400">{c.subsystem}</td>
              <td class="py-2.5 px-3 text-slate-300">{c.hoursLogged.toFixed(1)} h</td>
              <td class="py-2.5 px-3 text-slate-400">{c.condition}</td>
              <td class="py-2.5 px-3 text-center">
                <span class="text-emerald-400 font-bold">{c.wearScore}%</span>
              </td>
              <td class="py-2.5 px-3 text-center">
                <span class="text-[9px] px-2 py-0.5 rounded bg-emerald-950/50 text-emerald-300 border border-emerald-500/30">
                  {c.status}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Section 3: Split Grid: Recommended Inspections & Past Maintenance History -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
    
    <!-- Left: Recommended Inspections -->
    <div class="rounded-xl bg-[#0a0f1d] border border-slate-800/90 p-4 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
          <div class="flex items-center gap-2">
            <div class="p-1 rounded bg-amber-950/60 border border-amber-500/30 text-amber-400">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            </div>
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200">
                RECOMMENDED INSPECTIONS
              </h3>
              <p class="text-[11px] text-slate-400 font-mono-tech">
                PROGNOSTIC & TIME-BASED WORK PACKAGES
              </p>
            </div>
          </div>
          <span class="text-[10px] font-mono-tech px-2 py-0.5 rounded bg-amber-950/40 text-amber-300 border border-amber-500/30">
            1 IMMINENT
          </span>
        </div>

        <div class="mt-3 space-y-2.5">
          {inspectionChecklist.map((task) => (
            <div class="p-3 rounded-lg bg-[#0d1424] border border-slate-800 hover:border-slate-700 transition-colors">
              <div class="flex items-center justify-between mb-1">
                <div class="flex items-center gap-2">
                  <span class="text-[10px] text-cyan-400 font-mono-tech font-semibold bg-cyan-950/60 px-1.5 py-0.5 rounded border border-cyan-500/30">
                    {task.id}
                  </span>
                  <h4 class="text-xs font-bold text-slate-200">{task.title}</h4>
                </div>
                <span class:list={[
                  "text-[9px] px-1.5 py-0.5 rounded font-mono-tech border",
                  task.priority === "MANDATORY" ? "bg-rose-950/50 text-rose-300 border-rose-500/30" :
                  task.priority === "PREVENTIVE" ? "bg-amber-950/50 text-amber-300 border-amber-500/30" :
                  "bg-slate-800 text-slate-300 border-slate-700"
                ]}>
                  {task.priority}
                </span>
              </div>
              <p class="text-[11px] text-slate-400 my-1">{task.description}</p>
              <div class="flex items-center justify-between text-[10px] font-mono-tech text-slate-400 pt-2 border-t border-slate-800/60 mt-2">
                <span>INTERVAL: {task.interval}</span>
                <span class="text-amber-400 font-bold">DUE IN: {task.dueIn}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="pt-3 border-t border-slate-800/60 flex items-center justify-between text-[10px] font-mono-tech text-slate-400 mt-3">
        <span>WORK ORDER DISPATCH: READY</span>
        <button class="px-2.5 py-1 rounded bg-cyan-950 text-cyan-300 border border-cyan-500/40 hover:bg-cyan-900 transition-colors cursor-pointer">
          DISPATCH CHECKLIST ›
        </button>
      </div>
    </div>

    <!-- Right: Maintenance History Log -->
    <div class="rounded-xl bg-[#0a0f1d] border border-slate-800/90 p-4 shadow-sm flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
          <div class="flex items-center gap-2">
            <div class="p-1 rounded bg-violet-950/60 border border-violet-500/30 text-violet-400">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
              </svg>
            </div>
            <div>
              <h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200">
                HISTORICAL SERVICE RECORDS
              </h3>
              <p class="text-[11px] text-slate-400 font-mono-tech">
                ELECTRONIC ENGINE LOGBOOK (EEL) // CRYPTOGRAPHICALLY SIGNED
              </p>
            </div>
          </div>
          <span class="text-[10px] font-mono-tech px-2 py-0.5 rounded bg-emerald-950/40 text-emerald-400 border border-emerald-500/30">
            3 RECORDS
          </span>
        </div>

        <div class="mt-3 space-y-2.5">
          {maintenanceHistory.map((hist) => (
            <div class="p-3 rounded-lg bg-[#0d1424] border border-slate-800 text-xs font-mono-tech">
              <div class="flex items-center justify-between mb-1.5">
                <div class="flex items-center gap-2">
                  <span class="text-cyan-400 font-bold">{hist.woId}</span>
                  <span class="text-slate-500">|</span>
                  <span class="text-slate-400">{hist.date}</span>
                </div>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-950/50 text-emerald-300 border border-emerald-500/30">
                  {hist.status}
                </span>
              </div>
              <p class="text-[11px] text-slate-300 my-1 font-sans">{hist.action}</p>
              <div class="flex items-center justify-between text-[10px] text-slate-400 pt-2 border-t border-slate-800/60 mt-2">
                <span>HOURS: <strong class="text-slate-200">{hist.engineHrs}</strong></span>
                <span>SIGNATORY: <strong class="text-slate-300">{hist.tech}</strong></span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="pt-3 border-t border-slate-800/60 flex items-center justify-between text-[10px] font-mono-tech text-slate-400 mt-3">
        <span>LOG INTEGRITY: SHA-256 HASH VERIFIED</span>
        <button class="px-2.5 py-1 rounded bg-slate-900 text-slate-300 border border-slate-800 hover:bg-slate-800 transition-colors cursor-pointer">
          EXPORT PDF LOG ›
        </button>
      </div>
    </div>

  </div>
</div>
