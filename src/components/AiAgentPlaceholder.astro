           <button class="tts-stop-btn hidden inline-flex items-center gap-1 text-[9px] text-amber-400 hover:text-amber-300 border border-amber-500/30 rounded px-1.5 py-0.5 bg-slate-950/60 cursor-pointer font-mono-tech transition-colors" title="Stop audio">
