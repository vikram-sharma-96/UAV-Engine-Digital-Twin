        bargeInBtn.classList.remove('flex');
      }
    } else if (state === 'listening') {
      badgeEl.className += 'bg-amber-950/70 border border-amber-500/50 text-amber-300 shadow-[0_0_12px_rgba(245,158,11,0.25)]';
      badgeDot.className += 'bg-amber-400 animate-ping';
      badgeText.textContent = '🎙 Listening...';
      if (bargeInBtn) {
        bargeInBtn.classList.add('hidden');
        bargeInBtn.classList.remove('flex');
      }
    } else if (state === 'processing') {
      badgeEl.className += 'bg-cyan-950/70 border border-cyan-500/50 text-cyan-300 shadow-[0_0_12px_rgba(6,182,212,0.25)]';
      badgeDot.className += 'bg-cyan-400 animate-pulse';
