  }

  async function processAudioChunks(mimeType: string) {
    if (audioChunks.length === 0) {
      setVoiceState('ERROR');
      appendSystemNotice('No audio recorded. Please try again.');
      return;
    }

    const audioBlob = new Blob(audioChunks, { type: mimeType });
    const formData = new FormData();
    formData.append('audio', audioBlob, `recording.${mimeType.includes('webm') ? 'webm' : 'ogg'}`);

    setVoiceState('TRANSCRIBING');

    try {
      const resp = await fetch('http://localhost:8000/api/voice/transcribe', {
        method: 'POST',
        body: formData,
        signal: AbortSignal.timeout(30000),
      });

      const data = await resp.json();

      if (!data.success) {
        setVoiceState('ERROR');
        appendSystemNotice(data.message || 'Could not understand the audio. Please try again.');
        return;
      }

      const transcript: string = data.text;
      if (!transcript || !transcript.trim()) {
        setVoiceState('ERROR');
        appendSystemNotice('No speech detected. Please speak clearly into the microphone.');
        return;
      }

      inputEl.value = transcript;
      setVoiceState('THINKING');

      // Send as voice message with auto TTS
      await sendMessage(transcript, true);

    } catch (err: unknown) {
      setVoiceState('ERROR');
      const errMsg = (err instanceof Error && err.name === 'TimeoutError')
        ? 'Transcription timed out. Please try again.'
        : 'Could not understand the audio. Please try again.';
      appendSystemNotice(errMsg);
    }
  }

