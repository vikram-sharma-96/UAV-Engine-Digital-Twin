---
// Sidebar.astro - Aerospace Telemetry Navigation
interface NavItem {
  id: string;
  label: string;
  icon: string;
  active?: boolean;
  badge?: string;
}

const navItems: NavItem[] = [
  { id: "overview", label: "Overview", icon: "overview", active: true },
  { id: "digital-twin", label: "Digital Twin", icon: "twin", badge: "CORE" },
  { id: "engine-health", label: "Engine Health", icon: "health", badge: "94%" },
  { id: "fault-detection", label: "Fault Detection", icon: "faults", badge: "OK" },
  { id: "predictions", label: "Predictions", icon: "predictions" },
  { id: "maintenance", label: "Maintenance", icon: "maintenance" },
  { id: "sensor-data", label: "Sensor Data", icon: "sensors" }
];
---

<aside class="w-full lg:w-64 bg-[#090d18]/90 border-r border-slate-800/80 flex flex-col shrink-0">
  <!-- System Profile Eyebrow -->
  <div class="p-4 border-b border-slate-800/60">
    <div class="flex items-center justify-between text-[11px] font-mono-tech text-slate-400 mb-1">
      <span>UNIT DESIGNATION</span>
      <span class="text-cyan-400 font-semibold">UAV-PT900</span>
    </div>
    <div class="text-xs font-semibold text-slate-200 truncate">
      4-Cylinder Boxer UAV Engine
    </div>
    <div class="mt-2.5 flex items-center justify-between text-[10px] font-mono-tech bg-slate-950/60 p-2 rounded border border-slate-800/60 text-slate-400">
      <div>
        <div class="text-slate-400">RUN TIME</div>
        <div class="text-slate-200 font-bold">142.8 HRS</div>
      </div>
      <div class="text-right">
        <div class="text-slate-400">MISSION STATE</div>
        <div class="text-emerald-400 font-bold">CRUISE</div>
      </div>
    </div>
  </div>

  <!-- Navigation Menu -->
  <nav class="flex-1 p-3 space-y-1 overflow-y-auto" aria-label="Dashboard Navigation">
    <div class="px-2 py-1.5 text-[10px] font-mono-tech font-bold uppercase tracking-wider text-slate-400">
      Telemetry Channels
    </div>

    {navItems.map((item) => (
      <a
        href={`#${item.id}`}
        class:list={[
          "nav-item-link flex items-center justify-between px-3 py-2 rounded-md text-xs font-medium font-mono-tech transition-all group",
          item.active 
            ? "bg-cyan-950/50 text-cyan-300 border border-cyan-500/30 shadow-[0_0_12px_rgba(6,182,212,0.1)]"
            : "text-slate-400 hover:text-slate-200 hover:bg-slate-900/80 border border-transparent"
        ]}
        data-nav-id={item.id}
      >
        <div class="flex items-center gap-2.5">
          {item.icon === "overview" && (
            <svg class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="3" width="7" height="7" rx="1"></rect>
              <rect x="14" y="14" width="7" height="7" rx="1"></rect>
              <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            </svg>
          )}
          {item.icon === "twin" && (
            <svg class="w-4 h-4 text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
              <path d="M2 17l10 5 10-5"></path>
              <path d="M2 12l10 5 10-5"></path>
            </svg>
          )}
          {item.icon === "health" && (
            <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
            </svg>
          )}
          {item.icon === "faults" && (
            <svg class="w-4 h-4 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
              <line x1="12" y1="9" x2="12" y2="13"></line>
              <line x1="12" y1="17" x2="12.01" y2="17"></line>
            </svg>
          )}
          {item.icon === "predictions" && (
            <svg class="w-4 h-4 text-violet-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 14 14"></polyline>
            </svg>
          )}
          {item.icon === "maintenance" && (
            <svg class="w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
          )}
          {item.icon === "sensors" && (
            <svg class="w-4 h-4 text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 3v18h18"></path>
              <path d="M18 17V9"></path>
              <path d="M13 17V5"></path>
              <path d="M8 17v-3"></path>
            </svg>
          )}
          <span>{item.label}</span>
        </div>

        {item.badge && (
          <span class:list={[
            "text-[10px] px-1.5 py-0.2 rounded font-mono-tech border",
            item.active 
              ? "bg-cyan-900/60 text-cyan-300 border-cyan-400/40"
              : "bg-slate-800/80 text-slate-400 border-slate-700"
          ]}>
            {item.badge}
          </span>
        )}
      </a>
    ))}
  </nav>

  <!-- Bottom: Model & Diagnostic Info -->
  <div class="p-3 border-t border-slate-800/60 bg-slate-950/40 text-[11px] font-mono-tech space-y-2">
    <div class="flex items-center justify-between text-slate-400">
      <span>AI COGNITION</span>
      <span class="text-amber-400 flex items-center gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        OFFLINE
      </span>
    </div>
    <div class="flex items-center justify-between text-slate-400">
      <span>DIGITAL REPLICA</span>
      <span class="text-cyan-400">SYNCHRONIZED</span>
    </div>
    <div class="text-[10px] text-slate-400 pt-1 border-t border-slate-800/40 flex justify-between">
      <span>DIAG-PORT: CAN-0</span>
      <span>RATE: 1000 Hz</span>
    </div>
  </div>
</aside>

<script>
  // Smooth scroll and active state handler for navigation
  const links = document.querySelectorAll('.nav-item-link');
  links.forEach(link => {
    link.addEventListener('click', (e) => {
      links.forEach(l => {
        l.classList.remove('bg-cyan-950/50', 'text-cyan-300', 'border-cyan-500/30', 'shadow-[0_0_12px_rgba(6,182,212,0.1)]');
        l.classList.add('text-slate-400', 'border-transparent');
      });
      link.classList.add('bg-cyan-950/50', 'text-cyan-300', 'border-cyan-500/30', 'shadow-[0_0_12px_rgba(6,182,212,0.1)]');
      link.classList.remove('text-slate-400', 'border-transparent');
    });
  });
</script>
