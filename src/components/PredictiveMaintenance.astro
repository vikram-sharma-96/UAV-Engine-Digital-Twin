---
import { initialEngineData } from '../data/engineTelemetry';

const { predictive } = initialEngineData;
---

<div class="rounded-xl bg-[#0a0f1d] border border-slate-800/90 p-4 shadow-sm flex flex-col justify-between" id="maintenance">
  <!-- Header -->
  <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
    <div class="flex items-center gap-2">
      <div class="p-1 rounded bg-violet-950/60 border border-violet-500/30 text-violet-400">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 14 14"></polyline>
        </svg>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200">
          PREDICTIVE MAINTENANCE & REMAINING USEFUL LIFE (RUL)
        </h3>
        <p class="text-[11px] text-slate-400 font-mono-tech">
          MACHINE LEARNING PROGNOSTICS DEMO [MOCK INFERENCE]
        </p>
      </div>
    </div>

    <span class="text-[10px] font-mono-tech px-2 py-0.5 rounded bg-violet-950/40 text-violet-300 border border-violet-500/30">
      MOCK PREDICTIVE
    </span>
  </div>

  <!-- 4 Predictive Cards Grid -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 my-3">
    
    <!-- Card 1: Next Inspection -->
    <div class="p-3 rounded-lg bg-[#0d1424] border border-slate-800 flex flex-col justify-between hover:border-violet-500/30 transition-colors">
      <div class="text-[10px] font-mono-tech text-slate-400 uppercase">
        NEXT INSPECTION
      </div>
      <div class="my-1">
        <div id="pred-next-insp" class="text-base sm:text-lg font-bold font-mono-tech text-slate-100">
          {predictive.nextInspection}
        </div>
        <div class="text-[10px] text-emerald-400 font-mono-tech">
          SCHEDULE: CYCLE B
        </div>
      </div>
      <div class="text-[9px] text-slate-400 font-mono-tech flex justify-between pt-1 border-t border-slate-800/60">
        <span>PREVIOUS: 100 HRS</span>
        <span class="text-slate-400">FAA FAR 33.19</span>
      </div>
    </div>

    <!-- Card 2: Bearing Condition -->
    <div class="p-3 rounded-lg bg-[#0d1424] border border-slate-800 flex flex-col justify-between hover:border-violet-500/30 transition-colors">
      <div class="text-[10px] font-mono-tech text-slate-400 uppercase">
        BEARING CONDITION
      </div>
      <div class="my-1">
        <div id="pred-bearing-cond" class="text-base sm:text-lg font-bold font-mono-tech text-emerald-400 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          {predictive.bearingCondition}
        </div>
        <div class="text-[10px] text-slate-400 font-mono-tech">
          ROLLER HARMONICS: OK
        </div>
      </div>
      <div class="text-[9px] text-slate-400 font-mono-tech flex justify-between pt-1 border-t border-slate-800/60">
        <span>FATIGUE INDEX</span>
        <span class="text-emerald-400">0.03 (LOW)</span>
      </div>
    </div>

    <!-- Card 3: Cooling System -->
    <div class="p-3 rounded-lg bg-[#0d1424] border border-slate-800 flex flex-col justify-between hover:border-violet-500/30 transition-colors">
      <div class="text-[10px] font-mono-tech text-slate-400 uppercase">
        COOLING SYSTEM
      </div>
      <div class="my-1">
        <div id="pred-cooling-cond" class="text-base sm:text-lg font-bold font-mono-tech text-cyan-400 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
          {predictive.coolingSystem}
        </div>
        <div class="text-[10px] text-slate-400 font-mono-tech">
          CORE FLOW RESTRICTION: 0%
        </div>
      </div>
      <div class="text-[9px] text-slate-400 font-mono-tech flex justify-between pt-1 border-t border-slate-800/60">
        <span>THERMAL EFFICIENCY</span>
        <span class="text-cyan-400">97.2%</span>
      </div>
    </div>

    <!-- Card 4: Maintenance Risk -->
    <div class="p-3 rounded-lg bg-[#0d1424] border border-slate-800 flex flex-col justify-between hover:border-violet-500/30 transition-colors">
      <div class="text-[10px] font-mono-tech text-slate-400 uppercase">
        MAINTENANCE RISK
      </div>
      <div class="my-1">
        <div id="pred-maint-risk" class="text-base sm:text-lg font-bold font-mono-tech text-emerald-400 flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          {predictive.maintenanceRisk}
        </div>
        <div class="text-[10px] text-slate-400 font-mono-tech">
          DEGRADATION ANOMALY: NONE
        </div>
      </div>
      <div class="text-[9px] text-slate-400 font-mono-tech flex justify-between pt-1 border-t border-slate-800/60">
        <span>UNPLANNED STOP RISK</span>
        <span class="text-emerald-400">&lt;0.4%</span>
      </div>
    </div>

  </div>

  <div class="pt-2 border-t border-slate-800/60 flex items-center justify-between text-[10px] font-mono-tech text-slate-400">
    <span>REMAINING USEFUL LIFE: <strong id="pred-rul-val" class="text-slate-200">320 HRS</strong> (OVERHAUL LIMIT 500 HRS)</span>
    <span class="text-violet-400">ENSEMBLE LSTM PROGNOSTICS</span>
  </div>
</div>

<script>
  import type { EngineState } from '../data/engineSimulator';

  const brgCondition = document.getElementById('pred-bearing-cond');
  const coolCondition = document.getElementById('pred-cooling-cond');
  const maintRisk = document.getElementById('pred-maint-risk');
  const nextInsp = document.getElementById('pred-next-insp');
  const rulVal = document.getElementById('pred-rul-val');

  document.addEventListener('engine-state-update', ((e: CustomEvent<EngineState>) => {
    const s = e.detail;
    if (!s.predictive) return;

    if (brgCondition) {
      brgCondition.innerHTML = `<span class="w-2 h-2 rounded-full ${s.predictive.bearingColor === 'emerald' ? 'bg-emerald-400' : s.predictive.bearingColor === 'amber' ? 'bg-amber-400' : 'bg-rose-500'}"></span> ${s.predictive.bearingCondition}`;
      brgCondition.className = `text-base sm:text-lg font-bold font-mono-tech ${s.predictive.bearingColor === 'emerald' ? 'text-emerald-400' : s.predictive.bearingColor === 'amber' ? 'text-amber-400' : 'text-rose-400'} flex items-center gap-1.5`;
    }

    if (coolCondition) {
      coolCondition.innerHTML = `<span class="w-2 h-2 rounded-full ${s.predictive.coolingColor === 'cyan' ? 'bg-cyan-400' : s.predictive.coolingColor === 'amber' ? 'bg-amber-400' : 'bg-rose-500'}"></span> ${s.predictive.coolingSystem}`;
      coolCondition.className = `text-base sm:text-lg font-bold font-mono-tech ${s.predictive.coolingColor === 'cyan' ? 'text-cyan-400' : s.predictive.coolingColor === 'amber' ? 'text-amber-400' : 'text-rose-400'} flex items-center gap-1.5`;
    }

    if (maintRisk) {
      maintRisk.innerHTML = `<span class="w-2 h-2 rounded-full ${s.predictive.maintenanceColor === 'emerald' ? 'bg-emerald-400' : s.predictive.maintenanceColor === 'amber' ? 'bg-amber-400' : 'bg-rose-500'}"></span> ${s.predictive.maintenanceRisk}`;
      maintRisk.className = `text-base sm:text-lg font-bold font-mono-tech ${s.predictive.maintenanceColor === 'emerald' ? 'text-emerald-400' : s.predictive.maintenanceColor === 'amber' ? 'text-amber-400' : 'text-rose-400'} flex items-center gap-1.5`;
    }

    if (nextInsp) {
      nextInsp.textContent = `In ${s.predictive.nextInspectionHrs} Flight Hrs`;
    }

    if (rulVal) {
      const remaining = Math.round(320 * (s.healthScore / 100));
      rulVal.textContent = `${remaining} HRS`;
    }
  }) as EventListener);
</script>

