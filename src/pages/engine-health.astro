---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import EngineHealthPanel from '../components/EngineHealthPanel.astro';
import HealthSubsystems from '../components/HealthSubsystems.astro';
---

<DashboardLayout 
  title="Engine Health Monitoring | UAV Aero Engine"
  channelName="HEALTH MONITORING & SUBSYSTEM DEGRADATION"
  channelSubtitle="Multi-Sensor Kalman Fusion Subsystem Integrity & Mean Time Between Failure (MTBF)"
>
  <!-- Top Split Section: Large Health Score & Health Trend -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">
    
    <!-- Left: Subsystem Health Index with Large Radial Gauge (6 cols) -->
    <div class="lg:col-span-6 flex flex-col">
      <EngineHealthPanel />
    </div>

    <!-- Right: Health Stability & Degradation Trend (6 cols) -->
    <div class="lg:col-span-6 rounded-xl bg-[#0a0f1d] border border-slate-800/90 p-4 shadow-sm flex flex-col justify-between">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800/80">
        <div class="flex items-center gap-2">
          <div class="p-1 rounded bg-emerald-950/60 border border-emerald-500/30 text-emerald-400">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
          <div>
            <h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200">
              HISTORICAL HEALTH SCORE TREND
            </h3>
            <p class="text-[11px] text-slate-400 font-mono-tech">
              REAL-TIME ROLLING TELEMETRY INTEGRITY CURVE
            </p>
          </div>
        </div>
        <span id="health-trend-badge" class="text-[10px] font-mono-tech px-2 py-0.5 rounded bg-emerald-950/40 text-emerald-400 border border-emerald-500/30">
          STABLE (+0.1%)
        </span>
      </div>

      <!-- Real-Time Trend SVG -->
      <div class="relative w-full h-[150px] my-3">
        <svg class="w-full h-full overflow-visible" viewBox="0 0 400 100" preserveAspectRatio="none">
          <defs>
            <linearGradient id="gradHealthTrend" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#10b981" stop-opacity="0.35"/>
              <stop offset="100%" stop-color="#10b981" stop-opacity="0"/>
            </linearGradient>
          </defs>
          <line x1="0" y1="20" x2="400" y2="20" stroke="#1e293b" stroke-width="0.8" stroke-dasharray="2 2"/>
          <line x1="0" y1="50" x2="400" y2="50" stroke="#1e293b" stroke-width="0.8" stroke-dasharray="2 2"/>
          <line x1="0" y1="80" x2="400" y2="80" stroke="#1e293b" stroke-width="0.8" stroke-dasharray="2 2"/>
          
          <path id="path-health-area" d="M 0,25 L 40,24 L 80,26 L 120,23 L 160,25 L 200,24 L 240,25 L 280,24 L 320,26 L 360,24 L 400,25 L 400,100 L 0,100 Z" fill="url(#gradHealthTrend)"/>
          <path id="path-health-line" d="M 0,25 L 40,24 L 80,26 L 120,23 L 160,25 L 200,24 L 240,25 L 280,24 L 320,26 L 360,24 L 400,25" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
      </div>

      <div class="flex justify-between items-center text-[10px] font-mono-tech text-slate-400 pt-2 border-t border-slate-800/60">
        <span>T - 10 MINS</span>
        <span class="text-slate-400">KALMAN CONVERGENCE: &gt;99%</span>
        <span>NOW (T = 0)</span>
      </div>
    </div>

  </div>

  <!-- Detailed 5-Subsystem Breakdown Cards -->
  <HealthSubsystems />
</DashboardLayout>

<script>
  import type { EngineState } from '../data/engineSimulator';

  const healthLine = document.getElementById('path-health-line');
  const healthArea = document.getElementById('path-health-area');
  const trendBadge = document.getElementById('health-trend-badge');

  document.addEventListener('engine-state-update', ((e: CustomEvent<EngineState>) => {
    const s = e.detail;
    const score = s.healthScore;

    // Adjust Y coordinate based on score (100% -> Y:15, 50% -> Y:85)
    const currentY = Math.round(15 + ((100 - score) / 50) * 70);

    if (healthLine) {
      const d = `M 0,25 L 40,24 L 80,26 L 120,23 L 160,25 L 200,24 L 240,25 L 280,${Math.round((25 + currentY) / 2)} L 340,${currentY} L 400,${currentY}`;
      healthLine.setAttribute('d', d);
      if (score < 60) {
        healthLine.setAttribute('stroke', '#ef4444');
      } else if (score < 80) {
        healthLine.setAttribute('stroke', '#f59e0b');
      } else {
        healthLine.setAttribute('stroke', '#10b981');
      }
    }

    if (healthArea) {
      const d = `M 0,25 L 40,24 L 80,26 L 120,23 L 160,25 L 200,24 L 240,25 L 280,${Math.round((25 + currentY) / 2)} L 340,${currentY} L 400,${currentY} L 400,100 L 0,100 Z`;
      healthArea.setAttribute('d', d);
    }

    if (trendBadge) {
      if (score < 60) {
        trendBadge.className = 'text-[10px] font-mono-tech px-2 py-0.5 rounded bg-rose-950/40 text-rose-400 border border-rose-500/30';
        trendBadge.textContent = 'DEGRADED (-14.2%)';
      } else if (score < 80) {
        trendBadge.className = 'text-[10px] font-mono-tech px-2 py-0.5 rounded bg-amber-950/40 text-amber-400 border border-amber-500/30';
        trendBadge.textContent = 'CAUTION (-4.8%)';
      } else {
        trendBadge.className = 'text-[10px] font-mono-tech px-2 py-0.5 rounded bg-emerald-950/40 text-emerald-400 border border-emerald-500/30';
        trendBadge.textContent = 'STABLE (+0.1%)';
      }
    }
  }) as EventListener);
</script>
