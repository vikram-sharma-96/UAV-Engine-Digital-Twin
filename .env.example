# AeroTwin UAV Engine Digital Twin - Environment Configuration
# Copy this file to .env and supply your credentials if using online services.
#
# IMPORTANT: Never commit .env or raw API keys to Git!
# AeroTwin operates 100% offline out-of-the-box using local rule-ensemble
# and browser SpeechSynthesis fallback if these keys are absent.

# ==============================================================================
# 1. ELEVENLABS VOICE CONFIGURATION (Optional - Server-side only)
# ==============================================================================
# Your ElevenLabs API key. Required only for ultra-realistic neural voice streaming.
# If omitted or invalid, AeroTwin automatically uses client Web SpeechSynthesis.
ELEVENLABS_API_KEY=

# ElevenLabs Voice ID (Default: 21m00Tcm4TlvDq8ikWAM - Rachel / Flight Avionics Copilot)
# Aerospace Flight Advisory recommended: 21m00Tcm4TlvDq8ikWAM or EXAVITQu4vr4xnSDxMaL (Bella)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ElevenLabs Model (Default: eleven_turbo_v2_5 for lowest latency streaming)
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# Streaming Latency Optimization (0 = default, 1 = normal, 2 = strong, 3 = maximum, 4 = ultra-low)
ELEVENLABS_LATENCY_OPTIMIZATION=3

# Voice Stability and Similarity Boost [0.0 - 1.0]
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75

# ==============================================================================
# 2. LOCAL OLLAMA CONFIGURATION (Optional - Local AI reasoning)
# ==============================================================================
# Ollama daemon base URL (Default: http://127.0.0.1:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Recommended local model (e.g., llama3, mistral, or phi3)
OLLAMA_MODEL=llama3

# ==============================================================================
# 3. AEROTWIN SERVER PORTS
# ==============================================================================
PORT=4321
HOST=127.0.0.1
FASTAPI_BACKEND_PORT=8000
