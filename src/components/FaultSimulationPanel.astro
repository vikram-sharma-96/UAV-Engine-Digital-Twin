---
// FaultSimulationPanel.astro - Interactive UI Testbed
const simulationOptions = [
  { id: "normal", label: "Normal Operation", color: "emerald", icon: "check" },
  { id: "overheating", label: "Simulate Overheating", color: "amber", icon: "flame" },
  { id: "bearing", label: "Simulate Bearing Fault", color: "rose", icon: "zap" },
  { id: "oilPressure", label: "Simulate Low Oil Pressure", color: "rose", icon: "alert" },
  { id: "degradation", label: "Simulate Performance Degradation", color: "orange", icon: "trend" }
];
---

<div class="rounded-xl bg-[#0a0f1d] border border-cyan-500/30 p-4 shadow-sm" id="fault-simulation">
  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-slate-800/80">
    <div class="flex items-center gap-2">
      <div class="p-1 rounded bg-cyan-950/70 border border-cyan-500/40 text-cyan-400">
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="10 8 16 12 10 16 10 8"></polygon>
        </svg>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200 flex items-center gap-2">
          FAULT SIMULATION CONTROL CONSOLE
          <span class="text-[9px] px-1.5 py-0.2 rounded bg-cyan-950 text-cyan-300 border border-cyan-500/30">
            FRONTEND TESTBED
          </span>
        </h3>
        <p class="text-[11px] text-slate-400 font-mono-tech">
          TRIGGER ANOMALY STATES TO TEST DASHBOARD VISUALIZATIONS
        </p>
      </div>
    </div>

    <div class="text-[10px] font-mono-tech text-slate-400 flex items-center gap-1.5 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">
      <span>MODE:</span>
      <span id="active-sim-badge" class="text-emerald-400 font-bold">NORMAL OPERATION</span>
    </div>
  </div>

  <!-- Buttons Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5 my-3">
    {simulationOptions.map((opt, idx) => (
      <button
        type="button"
        class:list={[
          "sim-btn p-2.5 rounded-lg border text-xs font-mono-tech font-medium flex flex-col justify-between gap-2 transition-all group text-left cursor-pointer",
          idx === 0 
            ? "bg-emerald-950/40 border-emerald-500/50 text-emerald-200 shadow-[0_0_12px_rgba(16,185,129,0.15)] ring-1 ring-emerald-400/40" 
            : "bg-[#0d1424] border-slate-800 text-slate-300 hover:border-slate-700 hover:bg-slate-900"
        ]}
        data-sim-id={opt.id}
      >
        <div class="flex items-center justify-between">
          <span class="text-[10px] text-slate-400 group-hover:text-slate-300">SCENARIO {idx + 1}</span>
          {opt.icon === "check" && <span class="w-2 h-2 rounded-full bg-emerald-400"></span>}
          {opt.icon === "flame" && <span class="w-2 h-2 rounded-full bg-amber-400"></span>}
          {opt.icon === "zap" && <span class="w-2 h-2 rounded-full bg-rose-400"></span>}
          {opt.icon === "alert" && <span class="w-2 h-2 rounded-full bg-rose-500"></span>}
          {opt.icon === "trend" && <span class="w-2 h-2 rounded-full bg-orange-400"></span>}
        </div>
        <div class="font-semibold text-xs leading-tight">
          {opt.label}
        </div>
        <div class="text-[9px] text-slate-400 font-mono-tech flex items-center justify-between pt-1 border-t border-slate-800/60">
          <span>TRIGGER</span>
          <span class="text-cyan-400 opacity-0 group-hover:opacity-100 transition-opacity">› APPLY</span>
        </div>
      </button>
    ))}
  </div>

  <!-- Live Simulation Status Row -->
  <div class="pt-2 border-t border-slate-800/60 grid grid-cols-2 sm:grid-cols-4 gap-2 text-[10px] font-mono-tech">
    <div class="flex items-center gap-1.5">
      <span class="text-slate-400">MODE:</span>
      <span id="sim-info-mode" class="text-emerald-400 font-bold">NORMAL</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-slate-400">FAULT:</span>
      <span id="sim-info-fault" class="text-slate-300 font-bold">None</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-slate-400">RISK:</span>
      <span id="sim-info-risk" class="text-emerald-400 font-bold">LOW</span>
    </div>
    <div class="flex items-center gap-1.5">
      <span class="text-slate-400">ENGINE:</span>
      <span id="sim-info-status" class="text-emerald-400 font-bold">HEALTHY</span>
    </div>
  </div>
</div>

<script>
  import { simulator } from '../data/engineSimulator';
  import type { SimulationMode, EngineState } from '../data/engineSimulator';

  const simBtns = document.querySelectorAll('.sim-btn');
  const activeBadge = document.getElementById('active-sim-badge');

  // Fault panel info elements
  const simInfoMode = document.getElementById('sim-info-mode');
  const simInfoFault = document.getElementById('sim-info-fault');
  const simInfoRisk = document.getElementById('sim-info-risk');
  const simInfoStatus = document.getElementById('sim-info-status');

  const MODE_LABELS: Record<SimulationMode, string> = {
    normal: 'NORMAL OPERATION',
    overheating: 'SIMULATE OVERHEATING',
    bearing: 'SIMULATE BEARING FAULT',
    oilPressure: 'SIMULATE LOW OIL PRESSURE',
    degradation: 'SIMULATE PERFORMANCE DEGRADATION',
  };

  // Helper to get status color class
  function statusColorClass(status: string): string {
    if (status === 'HEALTHY') return 'text-emerald-400 font-bold';
    if (status === 'ADVISORY' || status === 'WARNING') return 'text-amber-400 font-bold';
    return 'text-rose-400 font-bold';
  }

  function riskColorClass(risk: string): string {
    if (risk === 'LOW') return 'text-emerald-400 font-bold';
    if (risk === 'MODERATE') return 'text-amber-400 font-bold';
    return 'text-rose-400 font-bold';
  }

  // Button click handler — triggers scenario switch
  simBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const simId = btn.getAttribute('data-sim-id') as SimulationMode;
      if (!simId) return;

      // Update button styling states (preserve existing visual behavior)
      simBtns.forEach(b => {
        b.classList.remove(
          'bg-emerald-950/40', 'border-emerald-500/50', 'text-emerald-200', 'shadow-[0_0_12px_rgba(16,185,129,0.15)]', 'ring-1', 'ring-emerald-400/40',
          'bg-amber-950/40', 'border-amber-500/50', 'text-amber-200', 'shadow-[0_0_12px_rgba(245,158,11,0.15)]', 'ring-amber-400/40',
          'bg-rose-950/40', 'border-rose-500/50', 'text-rose-200', 'shadow-[0_0_12px_rgba(244,63,94,0.15)]', 'ring-rose-400/40'
        );
        b.classList.add('bg-[#0d1424]', 'border-slate-800', 'text-slate-300');
      });

      if (simId === 'normal') {
        btn.classList.add('bg-emerald-950/40', 'border-emerald-500/50', 'text-emerald-200', 'ring-1', 'ring-emerald-400/40');
      } else if (simId === 'overheating' || simId === 'degradation') {
        btn.classList.add('bg-amber-950/40', 'border-amber-500/50', 'text-amber-200', 'ring-1', 'ring-amber-400/40');
      } else {
        btn.classList.add('bg-rose-950/40', 'border-rose-500/50', 'text-rose-200', 'ring-1', 'ring-rose-400/40');
      }
      btn.classList.remove('bg-[#0d1424]', 'border-slate-800', 'text-slate-300');

      // Update mode badge immediately
      if (activeBadge) {
        activeBadge.textContent = MODE_LABELS[simId] || simId.toUpperCase();
      }

      // Trigger the simulator — this starts the gradual transition
      simulator.setScenario(simId);
    });
  });

  // Listen for engine state updates and update fault panel info
  document.addEventListener('engine-state-update', ((e: CustomEvent<EngineState>) => {
    const state = e.detail;

    // Update mode badge color
    if (activeBadge) {
      activeBadge.className = statusColorClass(state.engineStatus);
    }

    // Update info row
    if (simInfoMode) {
      simInfoMode.textContent = MODE_LABELS[state.simulationMode] || state.simulationMode.toUpperCase();
      simInfoMode.className = statusColorClass(state.engineStatus);
    }
    if (simInfoFault) {
      simInfoFault.textContent = state.activeFault;
      simInfoFault.className = state.activeFault === 'None' ? 'text-slate-300 font-bold' : 'text-rose-400 font-bold';
    }
    if (simInfoRisk) {
      simInfoRisk.textContent = state.faultRisk;
      simInfoRisk.className = riskColorClass(state.faultRisk);
    }
    if (simInfoStatus) {
      simInfoStatus.textContent = state.engineStatus;
      simInfoStatus.className = statusColorClass(state.engineStatus);
    }
  }) as EventListener);
</script>
