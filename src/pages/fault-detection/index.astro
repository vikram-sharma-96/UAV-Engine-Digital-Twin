---
import Layout from '../../layouts/Layout.astro';
import FaultSimulationPanel from '../../components/FaultSimulationPanel.astro';
import FaultMonitoringPanel from '../../components/FaultMonitoringPanel.astro';
---

<Layout 
	title="Fault Detection & Isolation | UAV Aero Engine Digital Twin" 
	description="Autonomous Fault Detection, Isolation and Recovery (FDIR) Console with Interactive Fault Injection"
	activeRoute="/fault-detection"
>
	<!-- Page Header Banner -->
	<div class="flex flex-wrap items-center justify-between gap-3 p-3.5 rounded-xl bg-[#0a0f1e]/90 border border-slate-800/90 shadow-sm">
		<div>
			<div class="flex items-center gap-2">
				<span class="text-xs font-mono-tech font-bold text-amber-400 uppercase tracking-wider">
					FAULT DETECTION & ISOLATION (FDIR)
				</span>
				<span class="text-slate-600">|</span>
				<span class="text-xs font-mono-tech text-slate-400">
					AUTONOMOUS AVIONICS FAULT INJECTION & CLASSIFICATION
				</span>
			</div>
			<h2 class="text-sm sm:text-base font-semibold text-slate-100 mt-0.5">
				Real-Time Anomaly Classification, Root-Cause Isolation & Simulation Testbed
			</h2>
		</div>

		<div class="flex items-center gap-2 text-xs font-mono-tech">
			<div class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-slate-300 flex items-center gap-1.5">
				<span class="text-slate-500">ISOLATION:</span>
				<span class="text-emerald-400 font-bold">MULTI-HYPOTHESIS</span>
			</div>
		</div>
	</div>

	<!-- 1. Fault Simulation Console (Interactive Testbed Buttons) -->
	<FaultSimulationPanel />

	<!-- 2. Two-Column Diagnostic & Sensor Evidence Layout -->
	<div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">
		
		<!-- Left Column: Fault Monitoring & FIFO Event Log (6 cols) -->
		<div class="lg:col-span-6 flex flex-col">
			<FaultMonitoringPanel />
		</div>

		<!-- Right Column: Sensor Evidence Matrix & Threshold Analysis (6 cols) -->
		<div class="lg:col-span-6 rounded-xl bg-[#0a0f1d] border border-slate-800/90 p-4 shadow-sm flex flex-col justify-between">
			<!-- Top Header -->
			<div class="flex items-center justify-between pb-2.5 border-b border-slate-800/80">
				<div class="flex items-center gap-2">
					<div class="p-1 rounded bg-amber-950/60 border border-amber-500/30 text-amber-400">
						<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
							<polyline points="14 2 14 8 20 8"></polyline>
							<line x1="16" y1="13" x2="8" y2="13"></line>
							<line x1="16" y1="17" x2="8" y2="17"></line>
							<polyline points="10 9 9 9 8 9"></polyline>
						</svg>
					</div>
					<div>
						<h3 class="text-xs font-bold uppercase tracking-wider font-mono-tech text-slate-200">
							SENSOR EVIDENCE & ANOMALY RESIDUALS
						</h3>
						<p class="text-[10px] text-slate-400 font-mono-tech">
							DEVIATION FROM NOMINAL FLIGHT ENVELOPE
						</p>
					</div>
				</div>
				<span class="text-[10px] font-mono-tech text-slate-400 bg-slate-900 px-2 py-0.5 rounded border border-slate-800">
					Z-SCORE EVAL
				</span>
			</div>

			<!-- Sensor Evidence Matrix List -->
			<div class="space-y-2 my-3 font-mono-tech text-xs">
				<div class="p-2.5 rounded-lg bg-[#0d1424] border border-slate-800 flex items-center justify-between">
					<div>
						<div class="flex items-center gap-2 text-slate-200 font-semibold">
							<span class="w-2 h-2 rounded-full bg-amber-400"></span>
							Cylinder Head Temp (CHT)
						</div>
						<div class="text-[10px] text-slate-400 mt-0.5">Nominal: 78°C | Limit: 95°C</div>
					</div>
					<div class="text-right">
						<div class="text-slate-100 font-bold" id="fdir-temp-val">78.0 °C</div>
						<span id="fdir-temp-status" class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-950/60 text-emerald-400 border border-emerald-500/30">
							NOMINAL
						</span>
					</div>
				</div>

				<div class="p-2.5 rounded-lg bg-[#0d1424] border border-slate-800 flex items-center justify-between">
					<div>
						<div class="flex items-center gap-2 text-slate-200 font-semibold">
							<span class="w-2 h-2 rounded-full bg-rose-400"></span>
							Bearing Vibration (RMS 3-Axis)
						</div>
						<div class="text-[10px] text-slate-400 mt-0.5">Nominal: 1.2 mm/s | Limit: 3.5 mm/s</div>
					</div>
					<div class="text-right">
						<div class="text-slate-100 font-bold" id="fdir-vib-val">1.20 mm/s</div>
						<span id="fdir-vib-status" class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-950/60 text-emerald-400 border border-emerald-500/30">
							NOMINAL
						</span>
					</div>
				</div>

				<div class="p-2.5 rounded-lg bg-[#0d1424] border border-slate-800 flex items-center justify-between">
					<div>
						<div class="flex items-center gap-2 text-slate-200 font-semibold">
							<span class="w-2 h-2 rounded-full bg-blue-400"></span>
							Crankcase Lubrication Pressure
						</div>
						<div class="text-[10px] text-slate-400 mt-0.5">Nominal: 4.3 bar | Minimum: 2.5 bar</div>
					</div>
					<div class="text-right">
						<div class="text-slate-100 font-bold" id="fdir-oil-val">4.30 bar</div>
						<span id="fdir-oil-status" class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-950/60 text-emerald-400 border border-emerald-500/30">
							NOMINAL
						</span>
					</div>
				</div>

				<div class="p-2.5 rounded-lg bg-[#0d1424] border border-slate-800 flex items-center justify-between">
					<div>
						<div class="flex items-center gap-2 text-slate-200 font-semibold">
							<span class="w-2 h-2 rounded-full bg-cyan-400"></span>
							Tachometer & Engine RPM
						</div>
						<div class="text-[10px] text-slate-400 mt-0.5">Nominal: 5,200 RPM | Redline: 6,200 RPM</div>
					</div>
					<div class="text-right">
						<div class="text-slate-100 font-bold" id="fdir-rpm-val">5,200 RPM</div>
						<span id="fdir-rpm-status" class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-950/60 text-emerald-400 border border-emerald-500/30">
							NOMINAL
						</span>
					</div>
				</div>
			</div>

			<!-- Bottom FDIR Directive -->
			<div class="pt-2 border-t border-slate-800/60 flex items-center justify-between text-[10px] font-mono-tech text-slate-400">
				<span>AUTOMATED MITIGATION: ACTIVE</span>
				<span class="text-cyan-400 font-semibold">FDIR PROTOCOL: READY</span>
			</div>
		</div>

	</div>
</Layout>

<script>
	import type { EngineState } from '../../data/engineSimulator';

	const tempVal = document.getElementById('fdir-temp-val');
	const tempStatus = document.getElementById('fdir-temp-status');
	const vibVal = document.getElementById('fdir-vib-val');
	const vibStatus = document.getElementById('fdir-vib-status');
	const oilVal = document.getElementById('fdir-oil-val');
	const oilStatus = document.getElementById('fdir-oil-status');
	const rpmVal = document.getElementById('fdir-rpm-val');
	const rpmStatus = document.getElementById('fdir-rpm-status');

	document.addEventListener('engine-state-update', ((e: CustomEvent<EngineState>) => {
		const s = e.detail;

		// CHT
		if (tempVal) tempVal.textContent = `${s.temperature} °C`;
		if (tempStatus) {
			if (s.temperature > 95) {
				tempStatus.textContent = 'HIGH RESIDUAL (FAULT)';
				tempStatus.className = 'text-[9px] px-1.5 py-0.2 rounded bg-rose-950/60 text-rose-400 border border-rose-500/30 font-bold';
			} else if (s.temperature > 85) {
				tempStatus.textContent = 'ELEVATED';
				tempStatus.className = 'text-[9px] px-1.5 py-0.2 rounded bg-amber-950/60 text-amber-400 border border-amber-500/30 font-bold';
			} else {
				tempStatus.textContent = 'NOMINAL';
				tempStatus.className = 'text-[9px] px-1.5 py-0.2 rounded bg-emerald-950/60 text-emerald-400 border border-emerald-500/30';
			}
		}

		// Vibration
		if (vibVal) vibVal.textContent = `${s.vibration} mm/s`;
		if (vibStatus) {
			if (s.vibration > 3.5) {
				vibStatus.textContent = 'EXCESSIVE (FAULT)';
				vibStatus.className = 'text-[9px] px-1.5 py-0.2 rounded bg-rose-950/60 text-rose-400 border border-rose-500/30 font-bold';
			} else if (s.vibration > 2.0) {
				vibStatus.textContent = 'HARMONIC DRIFT';
				vibStatus.className = 'text-[9px] px-1.5 py-0.2 rounded bg-amber-950/60 text-amber-400 border border-amber-500/30 font-bold';
			} else {
				vibStatus.textContent = 'NOMINAL';
				vibStatus.className = 'text-[9px] px-1.5 py-0.2 rounded bg-emerald-950/60 text-emerald-400 border border-emerald-500/30';
			}
		}

		// Oil
		if (oilVal) oilVal.textContent = `${s.oilPressure} bar`;
		if (oilStatus) {
			if (s.oilPressure < 2.5) {
				oilStatus.textContent = 'LOW PRESSURE (FAULT)';
				oilStatus.className = 'text-[9px] px-1.5 py-0.2 rounded bg-rose-950/60 text-rose-400 border border-rose-500/30 font-bold';
			} else if (s.oilPressure < 3.5) {
				oilStatus.textContent = 'CAUTION';
				oilStatus.className = 'text-[9px] px-1.5 py-0.2 rounded bg-amber-950/60 text-amber-400 border border-amber-500/30 font-bold';
			} else {
				oilStatus.textContent = 'NOMINAL';
				oilStatus.className = 'text-[9px] px-1.5 py-0.2 rounded bg-emerald-950/60 text-emerald-400 border border-emerald-500/30';
			}
		}

		// RPM
		if (rpmVal) rpmVal.textContent = `${s.rpm.toLocaleString()} RPM`;
	}) as EventListener);
</script>
