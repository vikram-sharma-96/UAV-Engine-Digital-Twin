  // ─── TTS Playback (ElevenLabs + Browser SpeechSynthesis Fallback) ──────────────

  async function playTTS(
    text: string,
    playBtn?: HTMLButtonElement,
    stopBtn?: HTMLButtonElement,
    _autoPlay = false
  ) {
    if (voiceEngine === 'NONE') return;

    // Stop any currently playing audio
    stopAudio(playBtn, stopBtn);

    const spokenText = cleanTextForSpeech(text);
    if (!spokenText) return;

    setVoiceState('SPEAKING');
    if (playBtn) playBtn.classList.add('hidden');
    if (stopBtn) stopBtn.classList.remove('hidden');

    // Strategy 1: If ElevenLabs is configured, try ElevenLabs neural TTS
    if (voiceEngine === 'ELEVENLABS') {
      try {
        const resp = await fetch('http://localhost:8000/api/voice/speak', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: spokenText }),
          signal: AbortSignal.timeout(20000),
        });

        if (resp.ok) {
          const audioBlob = await resp.blob();
          currentAudioUrl = URL.createObjectURL(audioBlob);
          currentAudio = new Audio(currentAudioUrl);

          currentAudio.addEventListener('ended', () => {
            cleanupAudio();
            setVoiceState('IDLE');
            if (playBtn) playBtn.classList.remove('hidden');
            if (stopBtn) stopBtn.classList.add('hidden');
          });

          currentAudio.addEventListener('error', () => {
            cleanupAudio();
            // Fallback to browser TTS on playback error
            playBrowserSpeech(spokenText, playBtn, stopBtn);
          });

          await currentAudio.play();
          return;
        } else {
          // ElevenLabs returned error (e.g. 503, invalid key) -> fallback to browser speech
          console.warn('[Voice] ElevenLabs TTS returned error, falling back to Browser SpeechSynthesis');
        }
      } catch (err) {
        console.warn('[Voice] ElevenLabs TTS unreachable, falling back to Browser SpeechSynthesis', err);
      }
    }

    // Strategy 2: Browser SpeechSynthesis (Native)
    playBrowserSpeech(spokenText, playBtn, stopBtn);
  }

  function playBrowserSpeech(
    text: string,
    playBtn?: HTMLButtonElement,
    stopBtn?: HTMLButtonElement
  ) {
    if (!hasBrowserTTS) {
      cleanupAudio();
      setVoiceState('IDLE');
      if (playBtn) playBtn.classList.remove('hidden');
      if (stopBtn) stopBtn.classList.add('hidden');
      return;
    }

    window.speechSynthesis.cancel();

    browserUtterance = new SpeechSynthesisUtterance(text);
    browserUtterance.rate = 1.05;
    browserUtterance.pitch = 1.0;

    // Pick best English voice if available
    const voices = window.speechSynthesis.getVoices();
    const englishVoice = voices.find(v => v.lang.startsWith('en') && (v.name.includes('Natural') || v.name.includes('Google') || v.name.includes('Samantha') || v.name.includes('Guy') || v.name.includes('Jenny'))) ||
                         voices.find(v => v.lang.startsWith('en'));
    if (englishVoice) {
      browserUtterance.voice = englishVoice;
    }

    browserUtterance.onend = () => {
      cleanupAudio();
      setVoiceState('IDLE');
      if (playBtn) playBtn.classList.remove('hidden');
      if (stopBtn) stopBtn.classList.add('hidden');
    };

    browserUtterance.onerror = () => {
      cleanupAudio();
      setVoiceState('IDLE');
      if (playBtn) playBtn.classList.remove('hidden');
      if (stopBtn) stopBtn.classList.add('hidden');
    };

    window.speechSynthesis.speak(browserUtterance);
  }

  function stopAudio(
    playBtn?: HTMLButtonElement,
    stopBtn?: HTMLButtonElement
  ) {
    if (currentAudio) {
      currentAudio.pause();
      currentAudio = null;
    }
    if (hasBrowserTTS && window.speechSynthesis) {
      window.speechSynthesis.cancel();
    }
    browserUtterance = null;
    cleanupAudio();
    if (playBtn) playBtn.classList.remove('hidden');
    if (stopBtn) stopBtn.classList.add('hidden');
    if (voiceState === 'SPEAKING') setVoiceState('IDLE');
  }

  function cleanupAudio() {
    if (currentAudioUrl) {
      URL.revokeObjectURL(currentAudioUrl);
      currentAudioUrl = null;
    }
    currentAudio = null;
  }

  // ─── Send Message (text or transcribed voice) ─────────────────────────────────

  async function sendMessage(userText: string, autoPlayTTS = false) {
    const trimmed = userText.trim();
    if (!trimmed || isStreaming) return;

    inputEl.value = '';
    appendUserBubble(trimmed);
    chatHistory.push({ role: 'user', content: trimmed });

    const thinkingEl = appendThinkingBubble();
    setLoading(true);

    try {
      const historyForRequest = chatHistory.slice(0, -1);
      const body = {
        message: trimmed,
        history: historyForRequest,
        telemetry: currentTelemetry,
      };

      const response = await fetch('http://localhost:8000/api/ai/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
        signal: AbortSignal.timeout(65000),
      });

      if (!response.ok) {
        let errMsg = `Backend error ${response.status}`;
        try {
          const errData = await response.json();
          errMsg = errData.detail || errMsg;
        } catch {}
        throw new Error(errMsg);
      }

      const data = await response.json();
      const reply: string = data.reply || 'No response received.';

      if (footerModel && data.model) {
        footerModel.textContent = data.model;
      }

      // Show reply with speaker controls
      replaceThinkingWithReply(thinkingEl, reply, false, true);
      chatHistory.push({ role: 'assistant', content: reply });

      // Auto-play TTS for voice-initiated messages
      if (autoPlayTTS) {
        const bubble = thinkingEl.querySelector('div:nth-child(2)') as HTMLDivElement | null;
        const playBtn = bubble?.querySelector('.tts-play-btn') as HTMLButtonElement | undefined;
        const stopBtn = bubble?.querySelector('.tts-stop-btn') as HTMLButtonElement | undefined;
        await playTTS(reply, playBtn, stopBtn, true);
      }

    } catch (err: unknown) {
      let errText = 'Failed to reach Copilot.';
      if (err instanceof Error) {
        if (err.name === 'TimeoutError' || err.message.includes('timed out')) {
          errText = 'Request timed out. Ollama may be loading the model — please retry.';
        } else if (
          err.message.includes('fetch') ||
          err.message.includes('connect') ||
          err.message.includes('Failed to fetch')
        ) {
          errText = 'LOCAL AI OFFLINE — Start Ollama and the backend to enable AI diagnostics.';
        } else {
          errText = err.message;
        }
      }
      replaceThinkingWithReply(thinkingEl, errText, true, false);
      chatHistory.pop();
    } finally {
      setLoading(false);
      if (voiceState !== 'SPEAKING') {
        setVoiceState('IDLE');
      }
      inputEl.focus();
    }
  }

  // ─── Voice Recording (ElevenLabs STT or Browser Speech Recognition) ──────────

  async function startRecording() {
    if (voiceState === 'SPEAKING') {
      stopAudio();
      return;
    }
    if (voiceState !== 'IDLE') return;

    // If ElevenLabs is configured, record audio via MediaRecorder
    if (voiceEngine === 'ELEVENLABS') {
      await startMediaRecorderRecording();
    } else {
      // Use Browser Speech Recognition
      startBrowserRecognition();
    }
  }

  // ─── Option A: Browser Native SpeechRecognition ──────────────────────────────

  function startBrowserRecognition() {
    const SpeechRecognitionClass = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    if (!SpeechRecognitionClass) {
      startMediaRecorderRecording();
      return;
    }

    try {
      browserRecognition = new SpeechRecognitionClass();
      browserRecognition.continuous = false;
      browserRecognition.interimResults = true;
      browserRecognition.lang = 'en-US';

      let finalTranscript = '';

      browserRecognition.onstart = () => {
        setVoiceState('LISTENING');
        inputEl.placeholder = 'Listening... Speak into microphone';
      };

      browserRecognition.onresult = (event: any) => {
        let interim = '';
        for (let i = event.resultIndex; i < event.results.length; ++i) {
          const transcriptChunk = event.results[i][0].transcript;
          if (event.results[i].isFinal) {
            finalTranscript += transcriptChunk;
          } else {
            interim += transcriptChunk;
          }
        }
        inputEl.value = finalTranscript || interim;
      };

      browserRecognition.onerror = (event: any) => {
        console.warn('[SpeechRecognition] error:', event.error);
        if (event.error === 'not-allowed') {
          appendSystemNotice('MICROPHONE ACCESS REQUIRED — Please allow microphone permission in your browser.');
          setVoiceState('ERROR');
        } else if (event.error === 'no-speech') {
          setVoiceState('IDLE');
        } else {
          setVoiceState('ERROR');
        }
        inputEl.placeholder = 'Ask Copilot or click 🎤 to speak...';
      };

      browserRecognition.onend = () => {
        inputEl.placeholder = 'Ask Copilot or click 🎤 to speak...';
        if (finalTranscript && finalTranscript.trim()) {
          setVoiceState('THINKING');
          sendMessage(finalTranscript.trim(), true);
        } else {
          if (voiceState === 'LISTENING') {
            setVoiceState('IDLE');
          }
        }
        browserRecognition = null;
      };

      browserRecognition.start();

    } catch (err) {
      console.warn('[SpeechRecognition] failed to start, falling back to MediaRecorder', err);
      startMediaRecorderRecording();
    }
  }

  // ─── Option B: MediaRecorder (ElevenLabs STT) ────────────────────────────────

  async function startMediaRecorderRecording() {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      audioChunks = [];

      const mimeType = MediaRecorder.isTypeSupported('audio/webm;codecs=opus')
        ? 'audio/webm;codecs=opus'
        : MediaRecorder.isTypeSupported('audio/webm')
        ? 'audio/webm'
        : 'audio/ogg';

      mediaRecorder = new MediaRecorder(stream, { mimeType });

      mediaRecorder.ondataavailable = (e) => {
        if (e.data.size > 0) audioChunks.push(e.data);
      };

      mediaRecorder.onstop = async () => {
        stream.getTracks().forEach(t => t.stop());
        await processAudioChunks(mimeType);
      };

      mediaRecorder.start();
      setVoiceState('LISTENING');

      // Auto-stop after 30 seconds
      recordingTimeout = setTimeout(() => stopRecording(), 30000);

    } catch (err: unknown) {
      setVoiceState('ERROR');
      const msg = (err instanceof Error && err.name === 'NotAllowedError')
        ? 'MICROPHONE ACCESS REQUIRED — Please allow microphone permission in your browser.'
        : 'Could not access microphone.';
      appendSystemNotice(msg);
    }
  }

  function stopRecording() {
    if (recordingTimeout) {
      clearTimeout(recordingTimeout);
      recordingTimeout = null;
    }
    if (browserRecognition) {
      browserRecognition.stop();
      return;
    }
    if (mediaRecorder && mediaRecorder.state !== 'inactive') {
      mediaRecorder.stop();
